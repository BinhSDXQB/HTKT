// ─── TỔ CHỨC & NHÂN SỰ ──────────────────────────────────────────────────────
//
// Thiết kế chuẩn hoá phân cấp tổ chức:
//   ToChuc  → cây đơn vị (Sở → Phòng → Tổ / UBND → Ban)
//   ChucDanh → danh mục chức danh chuẩn
//   PhanCong → gắn cán bộ vào (đơn vị × chức danh), hỗ trợ kiêm nhiệm
//   CanBo    → hồ sơ cán bộ, có FK tới toChucId + chucDanhId (chính)

enum LoaiToChuc {
  SO                       // Sở / Cơ quan cấp tỉnh
  LANH_DAO_SO              // Nhóm lãnh đạo Sở (Giám đốc + Phó)
  VAN_PHONG                // Văn phòng Sở
  PHONG                    // Phòng chuyên môn
  BAN                      // Ban thuộc Sở
  TO                       // Tổ / Nhóm chuyên môn
  DON_VI_TRUC_THUOC        // Đơn vị trực thuộc (TT, XN, BQL...)
  UBND_PHUONG_XA           // UBND phường/xã (liên kết đơn vị hành chính)
  BAN_PHUONG_XA            // Ban/Bộ phận thuộc UBND phường/xã
}

enum LoaiChucDanh {
  LANH_DAO_SO              // Giám đốc, Phó Giám đốc Sở
  QUAN_LY                  // Trưởng/Phó phòng, Chánh/Phó VP
  CHUYEN_MON               // Chuyên viên, Kỹ sư, Kiến trúc sư
  HANH_CHINH               // Văn thư, Kế toán, Thủ quỹ, Lái xe, Bảo vệ, Tạp vụ (NĐ 111/2022)
  LANH_DAO_UBND            // Chủ tịch, Phó Chủ tịch UBND
  CONG_CHUC_PHUONG         // Công chức phường/xã
  LANH_DAO_DVSN            // Lãnh đạo đơn vị sự nghiệp trực thuộc (GĐ/Viện trưởng/Hiệu trưởng + phó) — NĐ 120/2020; KHÔNG phải lãnh đạo Sở
}

// Cây đơn vị tổ chức — hỗ trợ đệ quy (parentId)
model ToChuc {
  id           String      @id @default(cuid())
  ma           String      @unique               // VD: SO_XD, PHONG_HTKT, UBND_DONG_HOI
  ten          String                            // Tên đầy đủ
  tenVietTat   String?                           // Tên viết tắt / hiển thị ngắn
  loai         LoaiToChuc
  cap          Int         @default(1)           // 1=Sở, 2=Phòng/VP, 3=Tổ/Ban nhỏ
  thuTu        Int         @default(0)           // Thứ tự hiển thị trong cùng cấp
  isActive     Boolean     @default(true)
  moTa         String?
  maSoThue     String?                           // Mã số thuế của đơn vị (13 ký tự)

  // Phân cấp tự tham chiếu
  parentId     String?
  parent       ToChuc?     @relation("ToChucCon", fields: [parentId], references: [id])
  children     ToChuc[]    @relation("ToChucCon")

  // Liên kết đơn vị hành chính (dùng cho UBND phường/xã)
  donViHCId    String?
  donViHC      AdministrativeUnit? @relation("ToChucDonViHC", fields: [donViHCId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  canBos       CanBo[]     @relation("CanBoToChucChinh")
  phanCongs    PhanCong[]
  users        User[]      @relation("UserToChuc")
  congViecs    CongViec[]
  congViecLoais CongViecLoai[]
  lichCaNhans  LichCaNhan[]
  nghiepVuBanGhis NghiepVuBanGhi[]
  duAnGpmbs    DsDuAnGpmb[]    @relation("DsGpmbToChuc")

  @@index([parentId])
  @@index([loai])
  @@index([isActive])
  @@index([donViHCId])
  @@map("to_chuc")
}

// Danh mục chức danh chuẩn
model ChucDanh {
  id           String        @id @default(cuid())
  ma           String        @unique               // VD: GIAM_DOC, TRUONG_PHONG, CHUYEN_VIEN
  ten          String                              // Tên chức danh hiển thị
  loai         LoaiChucDanh
  capQuanLy    Int           @default(5)           // 1=GĐ, 2=PGĐ, 3=TP/CVP, 4=PP/PCVP/LX, 5=NV
  isLanhDao    Boolean       @default(false)       // Là vị trí lãnh đạo
  createdAt    DateTime      @default(now())

  canBos       CanBo[]      @relation("CanBoChucDanhChinh")
  phanCongs    PhanCong[]

  @@index([loai])
  @@index([capQuanLy])
  @@map("chuc_danh")
}

// Phân công cán bộ — hỗ trợ kiêm nhiệm nhiều đơn vị
model PhanCong {
  id           String    @id @default(cuid())

  canBoId      String
  canBo        CanBo     @relation(fields: [canBoId], references: [id], onDelete: Cascade)

  toChucId     String
  toChuc       ToChuc    @relation(fields: [toChucId], references: [id])

  chucDanhId   String
  chucDanh     ChucDanh  @relation(fields: [chucDanhId], references: [id])

  laChinh      Boolean   @default(true)   // Phân công chính (false = kiêm nhiệm)
  tuNgay       DateTime? @db.Date
  denNgay      DateTime? @db.Date         // NULL = đang giữ
  quyetDinhSo  String?                    // Số quyết định bổ nhiệm
  ghiChu       String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Index thật trong DB là UNIQUE ... NULLS NOT DISTINCT (mig 034) — Prisma chưa
  // biểu diễn được; KHÔNG để prisma migrate tự sinh lại index này.
  @@unique([canBoId, toChucId, chucDanhId, tuNgay])
  @@index([canBoId])
  @@index([toChucId])
  @@index([chucDanhId])
  @@index([denNgay])    // Lọc "đang giữ": denNgay IS NULL
  @@map("phan_cong")
}

// ─── DANH BẠ CÁN BỘ SỞ XÂY DỰNG ────────────────────────────────────────────

enum GioiTinh {
  NAM
  NU
}

enum DoiTuongNhanSu {
  CONG_CHUC       // Công chức (Luật CBCC 2025, NĐ 170/2025)
  VIEN_CHUC       // Viên chức (Luật Viên chức, NĐ 115/2020)
  NGUOI_LAO_DONG  // Người lao động / hợp đồng (BLLĐ 2019, NĐ 111/2022)
}

model CanBo {
  id            String     @id @default(cuid())
  cccd          String     @unique                // Số CCCD 12 số (cột BA biểu QLNS)
  hoTen         String
  // Text cũ giữ lại để backward-compat; dùng FK bên dưới để lọc chuẩn
  chucVu        String?                           // Text gốc (deprecated → dùng chucDanhId)
  phongBan      String?                           // Text gốc (deprecated → dùng toChucId)
  email         String?
  soDienThoai   String?
  ngaySinh      DateTime?  @db.Date
  heSoLuong     Float?                            // Cột V
  phuCap        Float?                            // Cột W: Phụ cấp chức vụ
  vuotKhung     Float?                            // Cột X: % vượt khung
  ngayNangLuong       DateTime?  @db.Date   // Cột Y: Ngày hưởng lương (bậc hiện tại)
  ngayNangLuongKeTiep DateTime?  @db.Date   // Cột AA: Ngày lên lương lần sau (= Y + 3 năm)

  // ── Nhân thân & cư trú (biểu QLNS cột G..M) ──
  gioiTinh      GioiTinh?
  queQuanTruoc  String?                           // G: Quê quán (trước hợp nhất)
  queQuanSau    String?                           // H: Quê quán (sau hợp nhất) — tự động chuyển đổi từ G
  noiOTruoc     String?                           // I: Nơi ở (trước hợp nhất)
  noiOHienNay   String?                           // J: Nơi ở (hiện nay)
  quangTriCuRa  String?                           // K: QT (cũ) ra

  // ── Phân loại đối tượng & hợp đồng lao động ──
  doiTuong             DoiTuongNhanSu?            // CC / VC / NLĐ — áp đúng chế độ
  viTriViecLam         String?                    // Vị trí việc làm (NĐ 62/2020, 106/2020)
  loaiHopDong          String?                    // Với NLĐ: KXĐTH / XĐTH 12 tháng / HĐ111...
  ngayKetThucHopDong   DateTime? @db.Date         // Hạn HĐ (NLĐ) — cảnh báo hết hạn

  // ── Biên chế & bổ nhiệm (cột N..S) ──
  loaiHinh             String?                    // N: BCHC / BCSN / HĐ...
  ngayVaoBienChe       DateTime? @db.Date         // O: Ngày vào BC, HĐ
  ngayVaoCongChucCoQuanNN DateTime? @db.Date      // Ngày vào công chức, cơ quan NN (từ bảng tính thi đua)
  boNhiemLanDau        String?                    // P: Bổ nhiệm lần đầu (text kèm ghi chú)
  ngayBoNhiemGanNhat   DateTime? @db.Date         // Q
  ngayBoNhiemTiepTheo  DateTime? @db.Date         // R = Q + 5 năm
  ngayVeHuu            DateTime? @db.Date         // S — ngày nghỉ hưu DỰ KIẾN (máy tính theo NĐ 135/2020)

  // ── Lùi thời điểm nghỉ hưu — NĐ 170/2025 Điều 61 khoản 3–5 (migration 045) ──
  // ngayVeHuu ở trên là ngày máy TÍNH. Ba cột dưới ghi QUYẾT ĐỊNH lùi của người có
  // thẩm quyền; nơi nào hiển thị/sinh văn bản thì lấy ngày lùi nếu có.
  ngayNghiHuuLui   DateTime? @db.Date             // Thời điểm nghỉ hưu sau khi lùi
  truongHopLui     String?                        // A ≤1 tháng · B ≤3 tháng · C ≤6 tháng
  vanBanLuiNghiHuu String?                        // Số, ngày văn bản quyết định lùi

  // ── Ngạch, bậc (cột T, U, AB, AC) ──
  maNgach          String?                        // T: VD 01.001
  bacLuong         Int?                           // U
  ngachHienHuong   String?                        // AB: CVCC/CVC/CV...
  ngayBoNhiemNgach DateTime? @db.Date             // AC — thời gian giữ ngạch tính từ đây

  // ── Trình độ đào tạo (cột AE..AT) ──
  trinhDoChuyenMon  String?                       // AE (nhiều dòng: TS/ThS/KS...)
  chuyenNganh       String?                       // AF
  namTotNghiep      String?                       // AG
  heDaoTao          String?                       // AH: Chính quy / Tại chức...
  trinhDoQLNN       String?                       // AI
  namDaoTaoQLNN     String?                       // AJ
  trinhDoLLCT       String?                       // AK: Cao cấp / Trung cấp...
  namDaoTaoLLCT     String?                       // AL
  trinhDoNgoaiNgu   String?                       // AM
  namDaoTaoNgoaiNgu String?                       // AN
  trinhDoTinHoc     String?                       // AO
  namDaoTaoTinHoc   String?                       // AP
  namDaoTaoCapPhong String?                       // AQ
  namDaoTaoCapSo    String?                       // AR
  qpAn              String?                       // AS: ĐT1/ĐT2/ĐT3...
  namDaoTaoQPAN     String?                       // AT

  // ── Đảng (cột AU..AW, AZ) — tuổi đời (AX), tuổi Đảng (AY) tính động ──
  soTheDang            String?                    // AU
  ngayKetNapDang       DateTime? @db.Date         // AV
  ngayVaoDangChinhThuc DateTime? @db.Date         // AW
  chiBo                String?                    // AZ

  // ── BHXH & Thuế (quản lý toàn diện) ──
  maSoBHXH        String?                            // Mã số BHXH (10 số)
  ngayThamGiaBHXH DateTime? @db.Date                 // Ngày bắt đầu tham gia BHXH
  maSoThue        String?                            // Mã số thuế cá nhân (TT 86/2024: dùng CCCD)

  trangThai     String     @default("DANG_CONG_TAC") // DANG_CONG_TAC/HOP_DONG/NGHI_HUU/CHUYEN_CONG_TAC/NGHI_VIEC
  ghiChu        String?

  // FK chuẩn hoá — đơn vị & chức danh chính
  toChucId      String?
  toChuc        ToChuc?    @relation("CanBoToChucChinh", fields: [toChucId], references: [id])
  chucDanhId    String?
  chucDanh      ChucDanh?  @relation("CanBoChucDanhChinh", fields: [chucDanhId], references: [id])

  userId        String?    @unique
  user          User?      @relation(fields: [userId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  phanCongs     PhanCong[]
  salaryHistory OfficeSalaryHistory[]
  workHistory   OfficeWorkHistory[]
  rewardRecords      OfficeRewardRecord[]
  annualEvaluations  OfficeAnnualEvaluation[]
  disciplineRecords  OfficeDisciplineRecord[]
  salaryReviewCases  OfficeSalaryReviewCase[]
  generatedDocuments OfficeGeneratedDocument[]
  leaveRequests      OfficeLeaveRequest[]
  conCai             ConCanBo[]

  @@index([phongBan])
  @@index([toChucId])
  @@index([chucDanhId])
  @@index([trangThai])
  @@index([chiBo])
  @@map("can_bo")
}

