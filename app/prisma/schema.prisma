// ─── DỮ LIỆU BÁO CÁO PHƯỜNG/XÃ (Legacy JSON — giữ lại để tương thích) ──────

enum WardReportCategory {
  DUONG           // Đường giao thông
  DIEN_CHIEU_SANG // Điện chiếu sáng
  CAY_XANH        // Cây xanh
  CONG_VIEN       // Công viên
  DIEN_TONG_HOP   // Điện tổng hợp
  THOAT_NUOC_BC   // Thoát nước
  CAP_NUOC_BC     // Cấp nước
  KHAC            // Khác
}

enum WardReportStatus {
  NHAP        // Bản nháp
  CHINH_THUC  // Chính thức / Đã xác nhận
}

model WardReport {
  id          String               @id @default(cuid())
  wardId      String?
  ward        AdministrativeUnit?  @relation("WardReports", fields: [wardId], references: [id])
  year        Int
  month       Int?                 // null = cả năm
  category    WardReportCategory
  sheetName   String?              // Tên sheet gốc trong Excel
  columns     Json                 // String[] — tên các cột
  rows        Json                 // (string|number|null)[][] — dữ liệu
  sourceFile  String?              // Tên file Excel gốc
  notes       String?
  status      WardReportStatus     @default(NHAP)
  createdById String
  createdBy   User                 @relation("WardReportCreator", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([wardId])
  @@index([year, category])
  @@index([status])
  @@index([createdById])
  @@map("ward_reports")
}

// ─── ĐỐI SOÁT GIS — nguồn thứ 3 (chiều dài hình học tuyến trong ranh đơn vị) ──
// Làm mới khi lớp bản đồ tuyến-duong thay đổi (hiếm). Nguồn: gis_do_chieu_dai.py.
// Đối soát LIVE: API cộng report_* (động) rồi so với các cột dưới đây.
model WardGisLength {
  id               String             @id @default(cuid())
  wardId           String             @unique
  ward             AdministrativeUnit @relation("WardGisLength", fields: [wardId], references: [id], onDelete: Cascade)
  duongDiaPhuongKm Float              @default(0) // đường chỉ có tên (địa phương/đô thị) — gần khai báo xã/phường
  duongHuyenKm     Float              @default(0)
  duongTinhKm      Float              @default(0)
  quocLoKm         Float              @default(0)
  caoTocKm         Float              @default(0)
  tongKm           Float              @default(0) // tổng toàn mạng đường trong ranh
  nguon            String?
  updatedAt        DateTime           @updatedAt

  @@map("ward_gis_length")
}

// ─── SỐ ĐƠN VỊ TỰ KHAI (từ dòng TỔNG báo cáo gốc) — để đối soát đủ 3 nguồn ───
model WardKhaiBao {
  id        String             @id @default(cuid())
  wardId    String
  ward      AdministrativeUnit @relation("WardKhaiBao", fields: [wardId], references: [id], onDelete: Cascade)
  year      Int
  linhVuc   String             // 'DUONG' | 'DIEN_CS' | 'THOAT_NUOC' | ...
  chiTieu   String             // 'chieuDaiKm' | 'soColDen' | 'chieuDaiM' | ...
  giaTri    Float
  donVi     String?            // km | cột | m | cây | m2 | hộ
  ghiChu    String?
  updatedAt DateTime           @updatedAt

  @@unique([wardId, year, linhVuc, chiTieu])
  @@index([year, linhVuc])
  @@map("ward_khai_bao")
}

