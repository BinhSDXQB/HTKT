// Lịch công tác cá nhân — mỗi người tự tạo; congKhai=true thì cả phòng cùng xem.
// loai/mauSac dùng String (không enum native) để tránh lỗi cast khi ghi.
model LichCaNhan {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("LichCaNhanUser", fields: [userId], references: [id])
  toChucId  String?
  toChuc    ToChuc?   @relation(fields: [toChucId], references: [id])
  tieuDe    String
  moTa      String?
  diaDiem   String?
  loai      String    @default("KHAC")  // HOP|CONG_TAC|TRUC|NGHI|KHAC
  mauSac    String?
  batDau    DateTime
  ketThuc   DateTime?
  congKhai  Boolean   @default(false)   // chia sẻ cho cả phòng (toChucId)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([toChucId])
  @@index([batDau])
  @@map("lich_ca_nhan")
}

// Hồ sơ nghiệp vụ động — dùng chung mọi phòng (QĐ 331). Trường riêng từng lĩnh vực
// lưu trong customFields (jsonb) theo schema ở lib/nghiep-vu/schema.ts. Cô lập theo toChucId.
model NghiepVuBanGhi {
  id           String    @id @default(cuid())
  linhVuc      String                            // key lĩnh vực = path sau /dashboard/
  toChucId     String?
  toChuc       ToChuc?   @relation(fields: [toChucId], references: [id])
  maBanGhi     String    @unique                  // NV-YYYY-NNNNNN
  tieuDe       String
  trangThai    String    @default("MOI")          // MOI|DANG_XU_LY|HOAN_THANH|HUY (text)

  // Địa bàn: wardId là NGUỒN LIÊN KẾT (mig 044); diaBan chỉ là nhãn hiển thị giữ
  // lại từ dữ liệu cũ. Đổi tên/sáp nhập phường xã không làm đứt liên kết nữa.
  wardId       String?
  ward         AdministrativeUnit? @relation("NghiepVuWard", fields: [wardId], references: [id])
  diaBan       String?
  ngayGhiNhan  DateTime?
  ghiChu       String?
  customFields Json                               // dữ liệu động theo schema lĩnh vực
  createdById  String?
  createdBy    User?     @relation("NghiepVuCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([linhVuc])
  @@index([toChucId])
  @@index([linhVuc, toChucId])
  @@index([createdById])
  @@index([wardId])
  @@map("nghiep_vu_ban_ghi")
}

// ── PHÂN CÔNG ĐỘNG & BÁO CÁO ĐỊNH KỲ (mig 028) ─────────────────────────────
// Bảng độc lập (không khai báo quan hệ Prisma tới User/ToChuc để tránh sửa model
// User đồ sộ); tên người/phòng resolve bằng truy vấn riêng. Scope theo toChucId.

