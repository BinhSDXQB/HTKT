  van_bang_tren_csdl    Boolean                @default(false)
  linh_vuc              String?
  noi_dung              String?
  loai_cong_trinh       String?
  hang_de_nghi          String?
  hanh_nghe_doc_lap     Boolean                @default(false)
  so_cchn_cu            String?
  ngay_bat_dau_kn       DateTime?              @db.Date
  nguon_bat_dau_kn      String?
  thanh_phan            Json                   @default("{}")
  trang_thai            String                 @default("MOI_TIEP_NHAN")
  ngay_yeu_cau_bo_sung  DateTime?              @db.Date
  noi_dung_bo_sung      String?
  ngay_nhan_du          DateTime?              @db.Date
  ngay_hoi_dong         DateTime?              @db.Date
  hang_hoi_dong         String?
  ket_luan_hoi_dong     String?
  ngay_thong_bao        DateTime?              @db.Date
  ngay_cap              DateTime?              @db.Date
  so_chung_chi          String?
  nang_luc_ca_nhan_id   String?
  ghi_chu               String?
  to_chuc_id            String?
  created_by_id         String?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?              @db.Timestamptz(6)
  cchn_kinh_nghiem      cchn_kinh_nghiem[]
