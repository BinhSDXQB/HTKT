  startDate       DateTime?            @db.Date  // Ngày khởi công
  endDate         DateTime?            @db.Date  // Ngày hoàn thành kế hoạch
  actualEndDate   DateTime?            @db.Date  // Ngày hoàn thành thực tế
  // Hồ sơ pháp lý
