  @@index([ma_dinh_danh], map: "idx_cchn_ho_so_ma_dd")
  @@index([ngay_nop(sort: Desc)], map: "idx_cchn_ho_so_ngay_nop")
  @@index([nang_luc_ca_nhan_id], map: "idx_cchn_ho_so_nlcn")
  @@index([trang_thai], map: "idx_cchn_ho_so_trang_thai")
}

model cchn_kinh_nghiem {
  id               String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  ho_so_id         String
  stt              Int        @default(0)
  ten_cong_trinh   String
  dia_diem         String?
  chu_dau_tu       String?
  loai_cong_trinh  String?
  cap_cong_trinh   String?
  nhom_du_an       String?
  cap_phe_duyet_qh String?
  loai_quy_hoach   String?
  vai_tro          String
  phan_viec        String?
  tu_ngay          DateTime?  @db.Date
  den_ngay         DateTime?  @db.Date
  tai_lieu         String?
  so_hieu_tai_lieu String?
  phu_hop_noi_dung Boolean?
  ghi_chu          String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  cchn_ho_so       cchn_ho_so @relation(fields: [ho_so_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ho_so_id, stt], map: "idx_cchn_kn_ho_so")
}

model cchn_lich_su {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  ho_so_id       String
  hanh_dong      String
  tu_trang_thai  String?
  den_trang_thai String?
  ghi_chu        String?
  nguoi_id       String?
  nguoi_ten      String?
  thoi_diem      DateTime   @default(now()) @db.Timestamptz(6)
  cchn_ho_so     cchn_ho_so @relation(fields: [ho_so_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ho_so_id, thoi_diem(sort: Desc)], map: "idx_cchn_ls_ho_so")
}

// ─── BẢNG TRUNG TÂM ĐỐI TƯỢNG HẠ TẦNG KỸ THUẬT (hub) — migration 049 ─────────────────────────────────
// Mọi đối tượng HTKT của xã/phường (đường, chiếu sáng, cây xanh, công viên, thoát nước mưa/thải/chung,
// cấp nước, bãi đỗ xe) là MỘT dòng; liên kết theo MÃ XÃ (administrative_units.code). 7 Biểu mẫu report_*
// trỏ về qua doiTuongId. so_hieu là cột GENERATED (CSDL tự tính) — KHÔNG ghi. Trigger fn_htkt_truoc_ghi tự cấp
// ma_doi_tuong, kiểm dải số Đ5 QĐ 56/2025, tính chiều dài/diện tích/tâm GIS, ghi lịch sử số hiệu.
model htkt_doi_tuong {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  ma_doi_tuong       String    @unique @default(dbgenerated("NULL")) // trigger cấp <mã xã>-<LV>-<NNNN>
  ma_xa              String
  linh_vuc           String
  ten                String?
  tuyen_duong_id     String?
  street_id          String?
  cap_duong          String?
  phan_loai_do_thi   String?
  thon               String?
  sh_so              Int?
  sh_chu_cai         String?
  so_hieu            String?
  sh_trang_thai      String?
  sh_so_qd           String?
  sh_ngay_qd         DateTime? @db.Date
  so_hieu_khac       String?
  so_hieu_cu         String?
  ten_cu             String?
  diem_dau           String?
  diem_cuoi          String?
  vi_tri             String?
  chieu_dai_m        Decimal?  @db.Decimal(12, 1)
  be_rong_nen_m      Decimal?  @db.Decimal(6, 2)
  be_rong_mat_m      Decimal?  @db.Decimal(6, 2)
  ket_cau_mat        String?
  dien_tich_m2       Decimal?  @db.Decimal(14, 1)
  so_luong           Int?
  nam_su_dung        Int?
  tinh_trang         String?
  don_vi_quan_ly     String?
  de_xuat_dieu_chinh String?
  thong_so           Json      @default("{}")
  geometry           Json?
  chieu_dai_gis_m    Decimal?  @db.Decimal(12, 1)
  dien_tich_gis_m2   Decimal?  @db.Decimal(14, 1)
  tam_lat            Decimal?  @db.Decimal(9, 6)
  tam_lng            Decimal?  @db.Decimal(9, 6)
  ngoai_ranh_pct     Decimal?  @db.Decimal(5, 1)
  lich_su            Json      @default("[]")
  ghi_chu            String?
  created_by_id      String?
  updated_by_id      String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  xa                 AdministrativeUnit @relation(fields: [ma_xa], references: [code], onDelete: NoAction)
  tuyen_duong        htkt_doi_tuong?    @relation("HtktTrenTuyen", fields: [tuyen_duong_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  doi_tuong_tren_tuyen htkt_doi_tuong[] @relation("HtktTrenTuyen")
  street             Street?            @relation(fields: [street_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  report_duong       ReportDuong[]
  report_dien_cs     ReportDienCS[]
  report_thoat_nuoc  ReportThoatNuoc[]
  report_cay_xanh    ReportCayXanh[]
  report_cong_vien   ReportCongVien[]
  report_cap_nuoc    ReportCapNuoc[]
  report_bai_do_xe   ReportBaiDoXe[]

  @@index([tuyen_duong_id], map: "idx_htkt_tuyen")
  @@index([created_by_id], map: "idx_htkt_created")
  @@index([updated_by_id], map: "idx_htkt_updated")
}