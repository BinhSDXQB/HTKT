generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTHENTICATION & RBAC ───────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  phone       String?
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  wardId      String?
  ward        AdministrativeUnit? @relation("UserWard", fields: [wardId], references: [id])

  // Phân quyền theo phòng ban — kế thừa cây tổ chức to_chuc
  toChucId           String?
  toChuc             ToChuc?  @relation("UserToChuc", fields: [toChucId], references: [id])
  isDepartmentLeader Boolean  @default(false)

  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  failedLoginCount  Int       @default(0)   // số lần nhập sai MK liên tiếp; ≥5 = khoá tới khi cấp lại
  lastLoginAt       DateTime?
  resetTokenHash      String?    // SHA-256 của token đặt lại mật khẩu (one-time)
  resetTokenExpiresAt DateTime?  // hạn token (thường 1 giờ)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogs           AuditLog[]
  assignedWorkOrders  WorkOrder[]        @relation("AssignedTo")
  createdWorkOrders   WorkOrder[]        @relation("CreatedBy")
  inspections         Inspection[]
  reportedIncidents   Incident[]         @relation("ReportedBy")
  resolvedIncidents   Incident[]         @relation("ResolvedBy")
  assetImports        AssetImportBatch[]
  wardReports         WardReport[]       @relation("WardReportCreator")
  canBo               CanBo?
  chatbotLogs         ChatbotLog[]
  reportDuong         ReportDuong[]      @relation("DuongCreator")
  reportDienCS        ReportDienCS[]     @relation("DienCSCreator")
  reportThoatNuoc     ReportThoatNuoc[]  @relation("ThoatNuocCreator")
  reportCayXanh       ReportCayXanh[]    @relation("CayXanhCreator")
  reportCongVien      ReportCongVien[]   @relation("CongVienCreator")
  reportCapNuoc       ReportCapNuoc[]    @relation("CapNuocCreator")
  reportBaiDoXe       ReportBaiDoXe[]    @relation("BaiDoXeCreator")
  officeSalaryEntries OfficeSalaryHistory[] @relation("OfficeSalaryCreator")
  officeWorkEntries   OfficeWorkHistory[]   @relation("OfficeWorkCreator")
  officeRewardEntries     OfficeRewardRecord[]     @relation("OfficeRewardCreator")
  officeEvalEntries       OfficeAnnualEvaluation[] @relation("OfficeEvalCreator")
  officeDisciplineEntries OfficeDisciplineRecord[] @relation("OfficeDisciplineCreator")
  salaryCasesCreated   OfficeSalaryReviewCase[] @relation("SalaryCaseCreator")
  salaryCasesReviewed  OfficeSalaryReviewCase[] @relation("SalaryCaseReviewer")
  salaryCasesApproved  OfficeSalaryReviewCase[] @relation("SalaryCaseApprover")
  generatedDocuments   OfficeGeneratedDocument[] @relation("OfficeDocCreator")
  // Quản lý công việc phòng/ban
  congViecGiao        CongViec[]          @relation("CongViecNguoiGiao")
  congViecPhuTrach    CongViec[]          @relation("CongViecNguoiPhuTrach")
  congViecTao         CongViec[]          @relation("CongViecCreatedBy")
  congViecThanhVien   CongViecThanhVien[] @relation("CongViecThanhVienUser")
  congViecNhatKy      CongViecNhatKy[]    @relation("CongViecNhatKyUser")
  lichCaNhans         LichCaNhan[]        @relation("LichCaNhanUser")
  nghiepVuTao         NghiepVuBanGhi[]    @relation("NghiepVuCreatedBy")

  @@index([toChucId])
  @@index([roleId])
  @@index([wardId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  module     String
  targetId   String?
  targetType String?
  detail     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── ĐƠN VỊ HÀNH CHÍNH ───────────────────────────────────────────────────────

model AdministrativeUnit {
  id        String                @id @default(cuid())
  code      String                @unique
  name      String
  fullName  String?
  type      AdministrativeUnitType
  parentId  String?
  parent    AdministrativeUnit?   @relation("UnitHierarchy", fields: [parentId], references: [id])
  children  AdministrativeUnit[]  @relation("UnitHierarchy")
  centerLat Float?                // Tọa độ trung tâm (approximate)
  centerLon Float?
  isActive  Boolean               @default(true)

  // Số liệu diện tích – dân số (NQ 1680/NQ-UBTVQH15; nguồn sapnhap.bando.com.vn)
  dienTichKm2  Decimal? @db.Decimal(9, 2) // Diện tích tự nhiên (km2)
  danSo        Int?                        // Quy mô dân số (người)
  trungTamHc   String?                     // Nơi đặt trung tâm hành chính
  truocSapNhap String?                     // Các ĐVHC cũ hợp thành
  huyenThiCu   String?                     // Huyện/TP/thị xã chủ quản trước sáp nhập
  vungLoi      String?                     // Lõi đô thị | Thuộc đô thị (phần xã) | Bán đô thị (thị trấn) | Nông thôn | Đặc khu

  // Dải số hiệu đường xã ("ĐX.") / đường thôn ("Đth.") — Điều 5 QĐ 56/2025/QĐ-UBND (mig 049); phường: null
  soHieuDxTu   Int?
  soHieuDxDen  Int?
  soHieuDthTu  Int?
  soHieuDthDen Int?
  soHieuCanCu  String?

  htktDoiTuong    htkt_doi_tuong[] // bảng trung tâm đối tượng HTKT, liên kết theo MÃ XÃ (code) — mig 049
  assets          Asset[]
  incidents       Incident[]
  projects        Project[]
  streets         Street[]
  wardReports     WardReport[]     @relation("WardReports")
  users           User[]           @relation("UserWard")
  reportDuong     ReportDuong[]    @relation("WardReportDuong")
  reportDienCS    ReportDienCS[]   @relation("WardReportDienCS")
  reportThoatNuoc ReportThoatNuoc[] @relation("WardReportThoatNuoc")
  reportCayXanh   ReportCayXanh[]  @relation("WardReportCayXanh")
  reportCongVien  ReportCongVien[] @relation("WardReportCongVien")
  reportCapNuoc   ReportCapNuoc[]  @relation("WardReportCapNuoc")
  reportBaiDoXe   ReportBaiDoXe[]  @relation("WardReportBaiDoXe")
  wardGisLength   WardGisLength?   @relation("WardGisLength")
  wardKhaiBao     WardKhaiBao[]    @relation("WardKhaiBao")
  nghiepVuBanGhis NghiepVuBanGhi[] @relation("NghiepVuWard")   // hồ sơ nghiệp vụ theo địa bàn (mig 044)
  // Mạng lưới hạ tầng
  denChieuSang    DenChieuSang[]       @relation("DenWard")
  cayXanh         CayXanhDuong[]       @relation("CayWard")
  hoGa            HoGa[]               @relation("HoGaWard")
  congThoatNuoc   CongThoatNuoc[]      @relation("CongWard")
  ongCapNuoc      OngCapNuoc[]         @relation("OngWard")
  vanCapNuoc      VanCapNuoc[]         @relation("VanWard")
  capVienThong    CapVienThong[]       @relation("CapWard")
  viaHe           ViaHe[]              @relation("ViaHeWard")
  tuyenMangLuoi   TuyenMangLuoi[]      @relation("TuyenWard")
  nhaMayXuLy      NhaMayXuLyNuocThai[] @relation("NhaMayWard")
  tramBom         TramBom[]            @relation("TramBomWard")
  toChuc          ToChuc[]             @relation("ToChucDonViHC")
  lanhDaoXa       LanhDaoXa[]          @relation("LanhDaoWard")
  duAnGpmbs       DsDuAnGpmb[]         @relation("DsGpmbWard")

  @@index([type])
  @@index([parentId])
  @@map("administrative_units")
}

// Lãnh đạo & Trưởng phòng Kinh tế của từng xã/phường (QĐ sắp xếp ĐVHC 2025).
// Cho phép tra cứu linh hoạt theo xã/phường, theo phòng ban, hoặc theo SĐT.
model LanhDaoXa {
  id          String             @id @default(cuid())
  wardId      String
  ward        AdministrativeUnit @relation("LanhDaoWard", fields: [wardId], references: [id], onDelete: Cascade)
  hoTen       String
  chucVu      String
  soDienThoai String?
  phongBan    String?            // Nhóm: Thường trực HĐND / Lãnh đạo UBND / Thường trực Đảng ủy / Phòng Kinh tế - Hạ tầng - Đô thị
  thuTu       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([wardId])
  @@index([soDienThoai])
  @@index([phongBan])
  @@map("lanh_dao_xa")
}

enum AdministrativeUnitType {
  TINH
  QUAN_HUYEN
  PHUONG_XA
}

model Street {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  wardId   String?
  ward     AdministrativeUnit? @relation(fields: [wardId], references: [id])
  length   Float?   // Chiều dài tổng tuyến (m)
  isActive Boolean @default(true)

  htktDoiTuong htkt_doi_tuong[] // hồ sơ đường trong bảng trung tâm HTKT (mig 049)

  // Tài sản legacy
  assets          Asset[]
  // Mạng lưới hạ tầng theo tuyến
  denChieuSang    DenChieuSang[]    @relation("DenTrenTuyen")
  cayXanh         CayXanhDuong[]    @relation("CayTrenTuyen")
  hoGa            HoGa[]            @relation("HoGaTrenTuyen")
  congThoatNuoc   CongThoatNuoc[]   @relation("CongTrenTuyen")
  ongCapNuoc      OngCapNuoc[]      @relation("OngTrenTuyen")
  vanCapNuoc      VanCapNuoc[]      @relation("VanTrenTuyen")
  capVienThong    CapVienThong[]    @relation("CapTrenTuyen")
  viaHe           ViaHe[]           @relation("ViaHeTrenTuyen")
  doanCong        DoanTuyenCong[]   @relation("DoanTrenTuyen")
  doanOng         DoanTuyenOng[]    @relation("DoanOngTrenTuyen")
  tramBom         TramBom[]         @relation("TramBomTrenTuyen")

  @@index([wardId])
  @@map("streets")
}

// ─── DANH MỤC HẠ TẦNG ────────────────────────────────────────────────────────

enum InfrastructureDomain {
  GIAO_THONG      // Đường giao thông
  CAP_NUOC        // Cấp nước
  THOAT_NUOC      // Thoát nước
  CHIEU_SANG      // Chiếu sáng đô thị
  CAY_XANH        // Cây xanh / Công viên
  MOI_TRUONG      // Môi trường / Thu gom rác
  CHINH_TRANG     // Chỉnh trang đô thị
}

model AssetType {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  domain      InfrastructureDomain
  description String?
  isActive    Boolean              @default(true)

  assets                Asset[]
  maintenanceSchedules  MaintenanceSchedule[]
  inspectionTemplates   InspectionTemplate[]
  importBatches         AssetImportBatch[]

  @@map("asset_types")
}

model ExecutingUnit {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  phone    String?
  email    String?
  address  String?
  isActive Boolean @default(true)

  workOrders WorkOrder[]
  projects   Project[]

  @@map("executing_units")
}

// ─── HỆ THỐNG MẠNG LƯỚI HẠ TẦNG KỸ THUẬT ───────────────────────────────────
// Tuyến đường là xương sống — mọi tài sản gắn vào theo lý trình (chainage)
// Hệ trục vị trí: lyTrinhM (mét từ đầu tuyến) + viTri (TRAI/PHAI/GIUA/TREN/DUOI)

enum AssetViTri {
  TRAI    // Bên trái chiều đi
  PHAI    // Bên phải chiều đi
  GIUA    // Giữa / Dải phân cách
  TREN    // Trên mặt đường
  DUOI    // Ngầm dưới mặt đường
}

enum TinhTrang {
  TOT        // Tốt — hoạt động bình thường
  KHA        // Khá — cần theo dõi
  TRUNG_BINH // Trung bình — cần bảo dưỡng
  XAU        // Xấu — cần sửa chữa
  HU_HONG    // Hỏng / Nguy hiểm — cần xử lý ngay
}

enum TrangThaiHoatDong {
  DANG_SU_DUNG  // Đang hoạt động
  DUNG_TAM      // Tạm dừng
  SUA_CHUA      // Đang sửa chữa
  NGUNG          // Ngưng vĩnh viễn
  THAO_DO        // Đã tháo dỡ
}

// ── ĐƯỜNG GIAO THÔNG (Street — backbone đã có, mở rộng thêm) ─────────────────
// Street model hiện tại: id, code, name, wardId, length, isActive
// Các tài sản đều có streetId → Street

// ── ĐÈN CHIẾU SÁNG ĐƯỜNG PHỐ ────────────────────────────────────────────────
model DenChieuSang {
  id              String             @id @default(cuid())
  maTS            String             @unique // Mã tài sản nội bộ
  streetId        String
  street          Street             @relation("DenTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("DenWard", fields: [wardId], references: [id])
  lyTrinhM        Float              // Vị trí lý trình (m từ đầu tuyến)
  viTri           AssetViTri         @default(PHAI)
  // Thông tin cột đèn
  chieuCaoCotM    Float?             // Chiều cao cột (m)
  vatLieuCot      String?            // Vật liệu cột (THEP/BE_TONG/COMPOSITE)
  loaiBong        String             // Loại bóng: LED / Sodium / Halogen
  loaiBongChuan   String?            // Đã chuẩn hoá cho thống kê
  congSuatW       Float?             // Công suất (W)
  quangThongLm    Float?             // Quang thông (lm)
  dieuKhien       String?            // TU_DONG / SENSOR / SCADA / THU_CONG
  capDien         String?            // NGAM / NOI
  voltageV        Float?             // Điện áp (V)
  tuDienId        String?            // Mã tủ điện điều khiển
  khoangCachTruM  Float?             // Khoảng cách giữa 2 trụ (m)
  coNangLuongMT   Boolean            @default(false)
  namLapDat       Int?
  hangSX          String?
  model           String?
  soSeri          String?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  latitude        Float?
  longitude       Float?
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId, lyTrinhM])
  @@index([wardId])
  @@index([loaiBongChuan])
  @@index([tinhTrang])
  @@map("den_chieu_sang")
}

// ── CÂY XANH ĐƯỜNG PHỐ ──────────────────────────────────────────────────────
model CayXanhDuong {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String
  street          Street             @relation("CayTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("CayWard", fields: [wardId], references: [id])
  lyTrinhM        Float              // Vị trí lý trình (m)
  viTri           AssetViTri         @default(TRAI)
  // Thông tin cây
  tenCay          String             // Tên phổ thông (Muồng, Phượng...)
  tenKhoaHoc      String?            // Tên khoa học
  viTriTrong      String?            // DUONG_PHO / CONG_VIEN / DAI_PHAN_CACH
  chieuCaoM       Float?             // Chiều cao (m)
  chuViCm         Float?             // Chu vi thân (cm) đo ở 1.3m
  duongKinhTanM   Float?             // Đường kính tán (m)
  tuoiNam         Int?               // Tuổi ước tính (năm)
  namTrong        Int?
  sucKhoe         String?            // KHOE_MANH / BINH_THUONG / YEU / SAU_BENH / NGUY_HIEM
  ngayCatTia      DateTime?          @db.Date
  ngayBonPhan     DateTime?          @db.Date
  coKhungBaoVe   Boolean            @default(false)
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  latitude        Float?
  longitude       Float?
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId, lyTrinhM])
  @@index([wardId])
  @@map("cay_xanh_duong")
}

// ── HỐ GA THOÁT NƯỚC (node trong mạng lưới) ─────────────────────────────────
model HoGa {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String?            // Hố ga thường nằm trên tuyến đường
  street          Street?            @relation("HoGaTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("HoGaWard", fields: [wardId], references: [id])
  lyTrinhM        Float?             // Vị trí lý trình (m)
  viTri           AssetViTri?        @default(TREN)
  // Thông số hố ga
  loaiHoGa        String             // THU_NUOC / KIEM_TRA / THOAT_KHI / CHIA_NUOC
  dkNapMm         Float?             // Đường kính/cạnh nắp (mm)
  chieuSauM       Float?             // Chiều sâu (m)
  vatLieuNap      String?            // GANG / COMPOSITE / BE_TONG
  vatLieuThanh    String?            // GACH / BE_TONG / HDPE
  soOngKetNoi     Int?               // Số ống cống kết nối
  caoDoDinhNapM   Float?             // Cao độ đỉnh nắp (m, VN-2000)
  taiTrongEN124   String?            // A15 / B125 / C250 / D400 / E600
  coLuoiChanRac  Boolean            @default(false)
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  latitude        Float?
  longitude       Float?
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Quan hệ mạng lưới: hố ga là node kết nối các đoạn cống
  congTuHoGaNay   CongThoatNuoc[] @relation("CongTu")
  congDenHoGaNay  CongThoatNuoc[] @relation("CongDen")

  @@index([streetId])
  @@index([wardId])
  @@map("ho_ga")
}

// ── CỐNG THOÁT NƯỚC (edge kết nối hố ga) ────────────────────────────────────
model CongThoatNuoc {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String
  street          Street             @relation("CongTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("CongWard", fields: [wardId], references: [id])
  lyTrinhTuM      Float              // Lý trình điểm đầu (m)
  lyTrinhDenM     Float              // Lý trình điểm cuối (m)
  viTri           AssetViTri         @default(DUOI)
  // Topology: cống nối 2 hố ga
  hoGaDauId       String?            // Hố ga đầu (upstream)
  hoGaDau         HoGa?              @relation("CongTu", fields: [hoGaDauId], references: [id])
  hoGaCuoiId      String?            // Hố ga cuối (downstream)
  hoGaCuoi        HoGa?              @relation("CongDen", fields: [hoGaCuoiId], references: [id])
  // Thông số kỹ thuật
  hinhDang        String             // TRON / VUONG / CHU_NHAT / BAN_NGUYET
  dkTrongMm       Float?             // Đường kính trong (mm) nếu tròn
  rong_Mm         Float?             // Chiều rộng (mm) nếu hộp
  cao_Mm          Float?             // Chiều cao (mm) nếu hộp
  chieuDaiM       Float?             // Chiều dài đoạn (m)
  vatLieu         String?            // BE_TONG / HDPE / PVC / GANG / GACH
  doSauDinhCongM  Float?             // Độ sâu đến đỉnh cống (m)
  caoDoDayCongM   Float?             // Cao độ đáy cống (m)
  doDocPct        Float?             // Độ dốc (%)
  huongThoat      String?            // Hướng thoát nước
  loaiNuoc        String?            // MUA / THAI / CHUNG
  luuLuongM3h     Float?             // Lưu lượng thiết kế (m³/h)
  namXayDung      Int?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId, lyTrinhTuM])
  @@index([hoGaDauId])
  @@index([hoGaCuoiId])
  @@map("cong_thoat_nuoc")
}

// ── ỐNG CẤP NƯỚC ─────────────────────────────────────────────────────────────
model OngCapNuoc {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String
  street          Street             @relation("OngTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("OngWard", fields: [wardId], references: [id])
  lyTrinhTuM      Float
  lyTrinhDenM     Float
  viTri           AssetViTri         @default(DUOI)
  // Thông số kỹ thuật
  vatLieu         String             // GANG_DEO / HDPE / UPVC / THEP / GANG_XAM
  dkTrongMm       Float              // Đường kính trong (mm)
  dkNgoaiMm       Float?             // Đường kính ngoài (mm)
  chieuDaiM       Float?             // Chiều dài đoạn (m)
  apSuatThietKeBar Float?            // Áp suất thiết kế (bar)
  apSuatVanHanhBar Float?            // Áp suất vận hành (bar)
  doSauChomM      Float?             // Độ sâu chôn (m)
  capMang         String?            // TRUYEN_DAN / PHAN_PHOI / DICH_VU
  kieuNoi         String?            // BICH / MIENG_BICH / HAN / VONG_CAO_SU
  namLapDat       Int?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Các van khóa trên đoạn ống này
  vanKhoa         VanCapNuoc[]

  @@index([streetId, lyTrinhTuM])
  @@map("ong_cap_nuoc")
}

// ── VAN KHOÁ CẤP NƯỚC ────────────────────────────────────────────────────────
model VanCapNuoc {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String?
  street          Street?            @relation("VanTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("VanWard", fields: [wardId], references: [id])
  ongCapNuocId    String?            // Thuộc đoạn ống nào
  ongCapNuoc      OngCapNuoc?        @relation(fields: [ongCapNuocId], references: [id])
  lyTrinhM        Float?
  loaiVan         String             // VAN_KHUA / VAN_BUOM / VAN_CAU / VAN_KIEM_TRA
  dkMm            Float              // Đường kính (mm)
  vatLieu         String?            // GANG / DONG / THEP
  apSuatBar       Float?             // Áp suất định mức (bar)
  doSauM          Float?             // Độ sâu lắp đặt (m)
  coHopBaoVe     Boolean            @default(true)
  vanHanh         String?            // TAY / DIEN / KHI_NEN
  namLapDat       Int?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  latitude        Float?
  longitude       Float?
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId])
  @@index([ongCapNuocId])
  @@map("van_cap_nuoc")
}

// ── CÁP VIỄN THÔNG ───────────────────────────────────────────────────────────
model CapVienThong {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String
  street          Street             @relation("CapTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("CapWard", fields: [wardId], references: [id])
  lyTrinhTuM      Float
  lyTrinhDenM     Float
  viTri           AssetViTri         @default(DUOI)
  // Thông số kỹ thuật
  donViMang       String             // VIETTEL / VNPT / MOBIFONE / FPT / SCTV / KHAC
  loaiCap         String             // QUANG / DONG / DONG_TRUC / CAT6
  hinhThucLapDat  String             // NGAM / NOI / NGAM_ONG
  soLoiSoi        Int?               // Số lõi/sợi quang
  dkOngBaoVeMm    Float?             // Đường kính ống bảo vệ (mm)
  vatLieuOng      String?            // HDPE / PVC / THEP
  doSauChomM      Float?             // Độ sâu chôn (m)
  chieuDaiM       Float?             // Chiều dài tuyến (m)
  bangThongGbps   Float?             // Băng thông (Gbps)
  namLapDat       Int?
  soHopMangSong   Int?               // Số hộp măng sông
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId, lyTrinhTuM])
  @@index([donViMang])
  @@map("cap_vien_thong")
}

// ── VỈA HÈ ──────────────────────────────────────────────────────────────────
model ViaHe {
  id              String             @id @default(cuid())
  maTS            String             @unique
  streetId        String
  street          Street             @relation("ViaHeTrenTuyen", fields: [streetId], references: [id])
  wardId          String?
  ward            AdministrativeUnit? @relation("ViaHeWard", fields: [wardId], references: [id])
  lyTrinhTuM      Float
  lyTrinhDenM     Float
  viTri           AssetViTri         // TRAI / PHAI (vỉa hè 2 bên)
  chieuDaiM       Float?             // Chiều dài đoạn (m)
  chieuRongM      Float?             // Chiều rộng vỉa hè (m)
  vatLieuLat      String?            // GACH_TU_NHIEN / GACH_BE_TONG / BT_XM
  coLeADuong      Boolean            @default(true)   // Có đá lề đường
  vatLieuLe       String?
  dienTichM2      Float?             // Diện tích (m²)
  coThoatNuoc    Boolean            @default(false)
  namXayDung      Int?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([streetId, lyTrinhTuM])
  @@map("via_he")
}

// ── TUYẾN MẠNG LƯỚI (Route qua nhiều đoạn đường) ────────────────────────────
// Ví dụ: Tuyến cống D600 đi từ Nhà máy XL → Trạm bơm → ra biển
// Gồm nhiều đoạn CongThoatNuoc hoặc OngCapNuoc trên các tuyến đường khác nhau

model TuyenMangLuoi {
  id            String             @id @default(cuid())
  maTuyen       String             @unique
  tenTuyen      String             // VD: "Tuyến cống D600 - Lê Duẩn → Trần Phú"
  loai          String             // CONG_THOAT_NUOC / ONG_CAP_NUOC / CAP_VIEN_THONG
  moTa          String?
  chieuDaiTongM Float?             // Tổng chiều dài tất cả đoạn (m)
  wardId        String?
  ward          AdministrativeUnit? @relation("TuyenWard", fields: [wardId], references: [id])
  // Điểm đầu / cuối của toàn tuyến
  diemBatDau    String?            // Mô tả điểm bắt đầu (VD: "Nhà máy XL nước thải A")
  diemKetThuc   String?            // Mô tả điểm kết thúc
  diemBatDauLat Float?
  diemBatDauLon Float?
  diemKetThucLat Float?
  diemKetThucLon Float?
  // Liên kết tới cơ sở xử lý
  nhaMayXuLyId  String?
  nhaMayXuLy    NhaMayXuLyNuocThai? @relation(fields: [nhaMayXuLyId], references: [id])
  tramBomId     String?
  tramBom       TramBom?           @relation("TramBomTuyen", fields: [tramBomId], references: [id])

  tinhTrang     TinhTrang          @default(TOT)
  trangThai     TrangThaiHoatDong  @default(DANG_SU_DUNG)
  namXayDung    Int?
  ghiChu        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Các đoạn cụ thể tạo nên tuyến này (theo thứ tự)
  doanCong      DoanTuyenCong[]
  doanOng       DoanTuyenOng[]

  @@index([loai])
  @@map("tuyen_mang_luoi")
}

// ── ĐOẠN TUYẾN CỐNG (1 đoạn trong TuyenMangLuoi qua 1 tuyến đường) ──────────
model DoanTuyenCong {
  id              String         @id @default(cuid())
  tuyenId         String
  tuyen           TuyenMangLuoi  @relation(fields: [tuyenId], references: [id])
  thuTu           Int            // Thứ tự đoạn trong tuyến (1, 2, 3...)
  streetId        String
  street          Street         @relation("DoanTrenTuyen", fields: [streetId], references: [id])
  lyTrinhTuM      Float          // Từ lý trình (m)
  lyTrinhDenM     Float          // Đến lý trình (m)
  chieuDaiM       Float?         // Chiều dài đoạn (tự tính = DenM - TuM)
  viTri           AssetViTri     @default(DUOI)
  // Thông số kỹ thuật đoạn này
  hinhDang        String?        // TRON / VUONG / CHU_NHAT
  dkTrongMm       Float?
  vatLieu         String?
  doDocPct        Float?
  ghiChu          String?

  @@index([tuyenId, thuTu])
  @@index([streetId])
  @@map("doan_tuyen_cong")
}

// ── ĐOẠN TUYẾN ỐNG CẤP NƯỚC (1 đoạn trong TuyenMangLuoi) ────────────────────
model DoanTuyenOng {
  id              String         @id @default(cuid())
  tuyenId         String
  tuyen           TuyenMangLuoi  @relation(fields: [tuyenId], references: [id])
  thuTu           Int
  streetId        String
  street          Street         @relation("DoanOngTrenTuyen", fields: [streetId], references: [id])
  lyTrinhTuM      Float
  lyTrinhDenM     Float
  chieuDaiM       Float?
  viTri           AssetViTri     @default(DUOI)
  dkTrongMm       Float?
  vatLieu         String?
  ghiChu          String?

  @@index([tuyenId, thuTu])
  @@map("doan_tuyen_ong")
}

// ── NHÀ MÁY XỬ LÝ NƯỚC THẢI ─────────────────────────────────────────────────
model NhaMayXuLyNuocThai {
  id              String             @id @default(cuid())
  maCS            String             @unique // Mã cơ sở
  ten             String             // Tên nhà máy
  wardId          String?
  ward            AdministrativeUnit? @relation("NhaMayWard", fields: [wardId], references: [id])
  diaChi          String?
  latitude        Float?
  longitude       Float?
  dienTichHa      Float?             // Diện tích (ha)
  // Thông số kỹ thuật
  congSuatThietKeM3Ngay Float?       // Công suất thiết kế (m³/ngày)
  congSuatHienTaiM3Ngay Float?       // Công suất hiện tại (m³/ngày)
  congNghe        String?            // Công nghệ xử lý (VD: A2O, MBR, MBBR)
  tieuchuanXaThai String?            // Tiêu chuẩn xả thải (QCVN 14:2008/A)
  nguonTiepNhan   String?            // Nguồn tiếp nhận nước thải đầu vào
  noiXaThai       String?            // Nơi xả thải sau xử lý (sông/biển...)
  namDuaVaoSuDung Int?
  donViQuanLy     String?            // Đơn vị quản lý vận hành
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tuyenDanVao     TuyenMangLuoi[]    // Các tuyến dẫn vào nhà máy
  tramBom         TramBom[]          // Trạm bơm thuộc nhà máy

  @@map("nha_may_xu_ly_nuoc_thai")
}

// ── TRẠM BƠM (Bơm thoát nước / cấp nước / nước thải) ─────────────────────────
model TramBom {
  id              String             @id @default(cuid())
  maCS            String             @unique
  ten             String
  loai            String             // THOAT_NUOC / CAP_NUOC / NUOC_THAI / PHONG_CHAY
  wardId          String?
  ward            AdministrativeUnit? @relation("TramBomWard", fields: [wardId], references: [id])
  streetId        String?            // Trạm bơm gần tuyến đường nào
  street          Street?            @relation("TramBomTrenTuyen", fields: [streetId], references: [id])
  lyTrinhM        Float?             // Vị trí lý trình nếu nằm trên tuyến
  diaChi          String?
  latitude        Float?
  longitude       Float?
  dienTichM2      Float?             // Diện tích trạm (m²)
  nhaMayXuLyId    String?            // Thuộc nhà máy xử lý nào (nếu có)
  nhaMayXuLy      NhaMayXuLyNuocThai? @relation(fields: [nhaMayXuLyId], references: [id])
  // Thông số kỹ thuật
  soBom           Int?               // Số máy bơm
  congSuatMoiBomKW Float?            // Công suất mỗi máy bơm (kW)
  luuLuongThietKeM3h Float?          // Lưu lượng thiết kế (m³/h)
  caoTrinh        Float?             // Cao trình đặt bơm (m)
  nguonDienKV     Float?             // Điện áp nguồn điện (kV)
  coMayPhatDuPhong Boolean           @default(false)
  coHoThuNuoc    Boolean            @default(true)
  dungTichHoM3    Float?             // Dung tích hố thu (m³)
  namXayDung      Int?
  donViQuanLy     String?
  tinhTrang       TinhTrang          @default(TOT)
  trangThai       TrangThaiHoatDong  @default(DANG_SU_DUNG)
  ghiChu          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tuyenDiRa       TuyenMangLuoi[]    @relation("TramBomTuyen")

  @@index([loai])
  @@index([wardId])
  @@map("tram_bom")
}

// ─── TÀI SẢN HẠ TẦNG (Legacy — giữ lại tương thích) ─────────────────────────

enum GeometryType {
  POINT    // Điểm: cây, đèn, hố ga, van nước
  LINE     // Đường: cống, ống nước, cáp, tuyến đường
  POLYGON  // Vùng: công viên, mảng xanh, khu vực
}

enum AssetCondition {
  TOT       // Tốt
  KHA       // Khá
  TRUNG_BINH // Trung bình
  XAU       // Xấu
  HONG      // Hỏng / Nguy hiểm
}

enum AssetStatus {
  DANG_SU_DUNG   // Đang sử dụng
  DUNG_TAM       // Dừng tạm thời
  DANG_SUA_CHUA  // Đang sửa chữa
  NGUNG_SU_DUNG  // Ngưng sử dụng
  THOAI_HOA      // Tháo dỡ / Thải bỏ
}

model Asset {
  id             String               @id @default(cuid())
  assetCode      String               @unique
  nationalCode   String?              @unique
  name           String
  assetTypeId    String
  assetType      AssetType            @relation(fields: [assetTypeId], references: [id])
  domain         InfrastructureDomain
  // Vị trí
  address        String?
  wardId         String?
  ward           AdministrativeUnit?  @relation(fields: [wardId], references: [id])
  streetId       String?
  street         Street?              @relation(fields: [streetId], references: [id])
  latitude       Float?
  longitude      Float?
  elevation      Float?               // Cao độ (m). Dương = trên mặt đất, Âm = ngầm dưới đất
  lyTrinh        Float?               // Lý trình: mét tính từ đầu tuyến (Km 0+000)
  viTriDuong     String?              // Vị trí ngang: TRAI | PHAI | GIUA | TREN
  geometryType   GeometryType         @default(POINT)
  geojson        Json?                // GeoJSON LineString/Polygon cho tài sản dạng đường/vùng
  // Thông tin cơ bản
  installDate    DateTime?            @db.Date
  warrantyExpiry DateTime?            @db.Date
  manufacturer   String?
  model          String?
  serialNumber   String?
  // Trạng thái
  condition      AssetCondition       @default(TOT)
  status         AssetStatus          @default(DANG_SU_DUNG)
  // Thông số kỹ thuật mở rộng theo từng lĩnh vực
  techSpecs      Json?
  notes          String?
  images         String[]             @default([])
  documents      String[]             @default([])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workOrders           WorkOrder[]
  inspections          Inspection[]
  incidents            Incident[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([domain])
  @@index([wardId])
  @@index([status])
  @@index([condition])
  @@map("assets")
}

// ─── LỊCH BẢO DƯỠNG ĐỊNH KỲ ─────────────────────────────────────────────────

enum MaintenanceFrequency {
  HANG_NGAY      // Hàng ngày
  HANG_TUAN      // Hàng tuần
  HANG_THANG     // Hàng tháng
  QUY            // Hàng quý (3 tháng)
  NAM_THANG      // 6 tháng
  HANG_NAM       // Hàng năm
}

model MaintenanceSchedule {
  id          String               @id @default(cuid())
  name        String
  assetTypeId String?
  assetType   AssetType?           @relation(fields: [assetTypeId], references: [id])
  assetId     String?
  asset       Asset?               @relation(fields: [assetId], references: [id])
  frequency   MaintenanceFrequency
  description String?
  lastDoneAt  DateTime?            @db.Date
  nextDueAt   DateTime?            @db.Date
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  workOrders WorkOrder[]

  @@map("maintenance_schedules")
}

// ─── KIỂM TRA HIỆN TRẠNG ────────────────────────────────────────────────────

model InspectionTemplate {
  id          String               @id @default(cuid())
  name        String
  domain      InfrastructureDomain
  assetTypeId String?
  assetType   AssetType?           @relation(fields: [assetTypeId], references: [id])
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    InspectionTemplate @relation(fields: [templateId], references: [id])
  name        String
  description String?
  inputType   InspectionInputType @default(RATING)
  sortOrder   Int                 @default(0)
  isRequired  Boolean             @default(true)

  results InspectionResult[]

  @@map("inspection_template_items")
}

enum InspectionInputType {
  RATING      // Điểm 1-5
  YES_NO      // Đạt / Không đạt
  TEXT        // Nhập text
  NUMBER      // Nhập số
  PHOTO       // Chụp ảnh
}

enum InspectionStatus {
  NHAP        // Bản nháp
  DANG_KIEM   // Đang kiểm tra
  HOAN_THANH  // Hoàn thành
  HUY         // Huỷ
}

model Inspection {
  id             String             @id @default(cuid())
  inspectionCode String             @unique
  templateId     String
  template       InspectionTemplate @relation(fields: [templateId], references: [id])
  assetId        String
  asset          Asset              @relation(fields: [assetId], references: [id])
  inspectorId    String
  inspector      User               @relation(fields: [inspectorId], references: [id])
  scheduledDate  DateTime           @db.Date
  inspectedAt    DateTime?
  conditionBefore AssetCondition?
  conditionAfter  AssetCondition?
  overallRating  Float?
  summary        String?
  status         InspectionStatus   @default(NHAP)
  images         String[]           @default([])
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  results   InspectionResult[]
  incidents Incident[]

  @@index([assetId])
  @@index([scheduledDate])
  @@map("inspections")
}

model InspectionResult {
  id         String                 @id @default(cuid())
  inspectionId String
  inspection   Inspection            @relation(fields: [inspectionId], references: [id])
  itemId       String
  item         InspectionTemplateItem @relation(fields: [itemId], references: [id])
  rating       Int?
  yesNo        Boolean?
  textValue    String?
  numberValue  Float?
  images       String[]              @default([])
  notes        String?

  @@unique([inspectionId, itemId])
  @@map("inspection_results")
}

// ─── SỰ CỐ & PHẢN ÁNH ────────────────────────────────────────────────────────

enum IncidentSource {
  BAO_CAO_NV    // Báo cáo nội bộ / nhân viên
  PHAN_ANH_CD   // Phản ánh từ công dân
  KET_QUA_KIEM  // Phát hiện qua kiểm tra
  HE_THONG      // Cảnh báo hệ thống / cảm biến
}

enum IncidentPriority {
  THAP    // Thấp
  TRUNG   // Trung bình
  CAO     // Cao
  KHAN_CAP // Khẩn cấp
}

enum IncidentStatus {
  MOI           // Mới tiếp nhận
  DA_TIEP_NHAN  // Đã tiếp nhận
  DANG_XU_LY   // Đang xử lý
  TAM_DUNG      // Tạm dừng chờ vật tư
  DA_GIAI_QUYET // Đã giải quyết
  DONG          // Đóng
}

model Incident {
  id            String               @id @default(cuid())
  incidentCode  String               @unique
  title         String
  description   String?
  source        IncidentSource       @default(BAO_CAO_NV)
  domain        InfrastructureDomain
  assetId       String?
  asset         Asset?               @relation(fields: [assetId], references: [id])
  inspectionId  String?
  inspection    Inspection?          @relation(fields: [inspectionId], references: [id])
  // Vị trí sự cố
  address       String?
  wardId        String?
  ward          AdministrativeUnit?  @relation(fields: [wardId], references: [id])
  latitude      Float?
  longitude     Float?
  // Phân loại & Ưu tiên
  priority      IncidentPriority     @default(TRUNG)
  status        IncidentStatus       @default(MOI)
  // Người báo cáo
  reportedById  String?
  reportedBy    User?                @relation("ReportedBy", fields: [reportedById], references: [id])
  reporterName  String?
  reporterPhone String?
  // Người xử lý
  resolvedById  String?
  resolvedBy    User?                @relation("ResolvedBy", fields: [resolvedById], references: [id])
  // Thời gian
  reportedAt    DateTime             @default(now())
  resolvedAt    DateTime?
  deadlineAt    DateTime?
  // Hình ảnh & Ghi chú
  images        String[]             @default([])
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workOrders WorkOrder[]

  @@index([domain])
  @@index([status])
  @@index([priority])
  @@index([reportedAt])
  @@map("incidents")
}

// ─── PHIẾU CÔNG VIỆC / BẢO TRÌ ───────────────────────────────────────────────

enum WorkOrderType {
  BAO_TRI_DINH_KY  // Bảo trì định kỳ
  SUA_CHUA         // Sửa chữa đột xuất
  KIEM_TRA         // Kiểm tra, quan trắc
  NAO_VET          // Nạo vét (thoát nước)
  THAY_THE         // Thay thế thiết bị
  CAI_TAO          // Cải tạo, nâng cấp nhỏ
}

enum WorkOrderStatus {
  MOI           // Mới tạo
  DA_GIAO       // Đã giao
  DANG_THUC_HIEN // Đang thực hiện
  TAM_DUNG      // Tạm dừng
  HOAN_THANH    // Hoàn thành
  NGHIEM_THU    // Đã nghiệm thu
  HUY           // Huỷ
}

enum WorkOrderPriority {
  THAP
  TRUNG
  CAO
  KHAN_CAP
}

model WorkOrder {
  id              String            @id @default(cuid())
  workOrderCode   String            @unique
  title           String
  type            WorkOrderType
  priority        WorkOrderPriority @default(TRUNG)
  status          WorkOrderStatus   @default(MOI)
  domain          InfrastructureDomain
  // Liên kết
  assetId         String?
  asset           Asset?            @relation(fields: [assetId], references: [id])
  incidentId      String?
  incident        Incident?         @relation(fields: [incidentId], references: [id])
  scheduleId      String?
  schedule        MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  // Đơn vị thực hiện
  executingUnitId String?
  executingUnit   ExecutingUnit?    @relation(fields: [executingUnitId], references: [id])
  assignedToId    String?
  assignedTo      User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User              @relation("CreatedBy", fields: [createdById], references: [id])
  // Thời gian
  plannedStart    DateTime?         @db.Date
  plannedEnd      DateTime?         @db.Date
  actualStart     DateTime?
  actualEnd       DateTime?
  // Chi phí
  estimatedCost   Float?
  actualCost      Float?
  // Nội dung
  description     String?
  resolution      String?
  images          String[]          @default([])
  documents       String[]          @default([])
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  materials WorkOrderMaterial[]

  @@index([domain])
  @@index([status])
  @@index([plannedStart])
  @@index([assetId])
  @@map("work_orders")
}

model WorkOrderMaterial {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  name        String
  unit        String
  quantity    Float
  unitPrice   Float?
  totalPrice  Float?
  notes       String?

