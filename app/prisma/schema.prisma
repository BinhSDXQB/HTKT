// ============================================================
//  VĂN PHÒNG SỞ — Hồ sơ nhân sự & lương (Commit 2)
//  Hồ sơ gốc dùng lại bảng can_bo; các bảng dưới lưu lịch sử & cấu hình.
// ============================================================

enum LoaiNangLuong {
  THUONG_XUYEN   // Nâng lương thường xuyên
  TRUOC_HAN      // Nâng lương trước thời hạn
  DOT_XUAT       // Nâng lương đột xuất
  VUOT_KHUNG     // Phụ cấp thâm niên vượt khung
  KHAC
}

/// Lịch sử lương — mỗi lần thay đổi bậc/hệ số/phụ cấp của cán bộ
model OfficeSalaryHistory {
  id            String        @id @default(cuid())
  canBoId       String
  canBo         CanBo         @relation(fields: [canBoId], references: [id], onDelete: Cascade)

  loai          LoaiNangLuong @default(THUONG_XUYEN)
  bacLuong      Int?                                  // Bậc lương
  heSoLuong     Float                                 // Hệ số lương tại thời điểm hưởng
  phuCapChucVu  Float?                                // Phụ cấp chức vụ
  vuotKhung     Float?                                // % thâm niên vượt khung
  ngayHuong     DateTime      @db.Date                // Ngày được hưởng
  ngayNangTiep  DateTime?     @db.Date                // Dự kiến ngày nâng lương kế tiếp
  soQuyetDinh   String?                               // Số QĐ lương
  ngayQuyetDinh DateTime?     @db.Date
  ghiChu        String?

  createdById   String?
  createdBy     User?         @relation("OfficeSalaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([canBoId])
  @@index([ngayHuong])
  @@index([loai])
  @@map("office_salary_history")
}

/// Quá trình công tác — đơn vị/chức vụ theo thời gian
model OfficeWorkHistory {
  id            String    @id @default(cuid())
  canBoId       String
  canBo         CanBo     @relation(fields: [canBoId], references: [id], onDelete: Cascade)

  tuNgay        DateTime  @db.Date
  denNgay       DateTime? @db.Date                    // NULL = hiện tại
  donVi         String                                // Tên đơn vị công tác
  chucVu        String?                               // Chức vụ tại đơn vị
  noiDung       String?                               // Mô tả quá trình/nhiệm vụ
  soQuyetDinh   String?
  ghiChu        String?

  createdById   String?
  createdBy     User?     @relation("OfficeWorkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([canBoId])
  @@index([tuNgay])
  @@map("office_work_history")
}

/// Cấu hình quy tắc nâng lương — KHÔNG hard-code điều kiện pháp lý vào code.
/// Văn phòng cập nhật khi văn bản thay đổi.
model OfficeSalaryRule {
  id                       String    @id @default(cuid())
  ma                       String    @unique          // VD: CC_A1, VC_LOAI_A
  ten                      String
  loaiCanBo                String?                     // Công chức / Viên chức / NLĐ
  nhomNgach                String?                     // Nhóm ngạch / chức danh nghề nghiệp
  soNamGiuBac              Int?                        // Số năm giữ bậc để nâng thường xuyên
  soThangGiuBac            Int?                        // Hoặc tính theo tháng (cán bộ loại C…)
  bacToiDa                 Int?                        // Bậc cuối của ngạch
  heSoVuotKhungBatDau      Float?                      // % vượt khung khi đạt bậc cuối
  phanTramVuotKhungMoiNam  Float?                      // % cộng thêm mỗi năm vượt khung
  vanBanCanCu              String?                     // Số/tên văn bản căn cứ
  hieuLucTuNgay            DateTime? @db.Date
  hieuLucDenNgay           DateTime? @db.Date
  isActive                 Boolean   @default(true)
  moTa                     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([isActive])
  @@map("office_salary_rules")
}

// ============================================================
//  VĂN PHÒNG SỞ — Thi đua, khen thưởng, đánh giá, kỷ luật (Commit 3)
//  Hồ sơ gốc dùng lại can_bo; các bảng dưới lưu thành tích & quá trình.
// ============================================================

enum LoaiKhenThuong {
  DANH_HIEU   // Danh hiệu thi đua (LĐTT, CSTĐ cơ sở...)
  HINH_THUC   // Hình thức khen thưởng (Giấy khen, Bằng khen...)
}

/// Danh mục danh hiệu / hình thức khen thưởng — config, KHÔNG hard-code vào code.
model OfficeRewardTitle {
  id        String         @id @default(cuid())
  ma        String         @unique
  ten       String
  loai      LoaiKhenThuong @default(DANH_HIEU)
  capKhen   String?        // Cấp khen: Cơ sở / Tỉnh / Bộ / Nhà nước
  thuTu     Int            @default(0)
  isActive  Boolean        @default(true)
  moTa      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  rewardRecords OfficeRewardRecord[]

  @@index([isActive])
  @@index([loai])
  @@map("office_reward_titles")
}

/// Đợt / phong trào thi đua
model OfficeEmulationMovement {
  id          String    @id @default(cuid())
  ten         String
  nam         Int
  capPhatDong String?   // Cấp phát động (Sở / Tỉnh / Bộ...)
  tuNgay      DateTime? @db.Date
  denNgay     DateTime? @db.Date
  moTa        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rewardRecords OfficeRewardRecord[]

  @@index([nam])
  @@index([isActive])
  @@map("office_emulation_movements")
}

/// Khen thưởng / danh hiệu cán bộ đã đạt
model OfficeRewardRecord {
  id              String   @id @default(cuid())
  canBoId         String
  canBo           CanBo    @relation(fields: [canBoId], references: [id], onDelete: Cascade)
  rewardTitleId   String?
  rewardTitle     OfficeRewardTitle?       @relation(fields: [rewardTitleId], references: [id], onDelete: SetNull)
  movementId      String?
  movement        OfficeEmulationMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  nam             Int
  danhHieu        String?   // Snapshot tên danh hiệu (khi không chọn từ danh mục)
  capKhen         String?
  soQuyetDinh     String?
  ngayQuyetDinh   DateTime? @db.Date
  coQuanQuyetDinh String?
  thanhTich       String?   // Tóm tắt thành tích
  ghiChu          String?

  createdById     String?
  createdBy       User?     @relation("OfficeRewardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([canBoId])
  @@index([nam])
  @@index([rewardTitleId])
  @@index([movementId])
  @@map("office_reward_records")
}

/// Khen thưởng / danh hiệu TẬP THỂ (đơn vị). toChucId NULL nếu đơn vị đã giải thể.
model OfficeCollectiveRewardRecord {
  id              String   @id @default(cuid())
  toChucId        String?   // liên kết tới đơn vị trong cây tổ chức; null = đơn vị đã giải thể
  tenTapThe       String    // tên tập thể theo QĐ (luôn lưu, kể cả đơn vị đã giải thể; "còn tồn tại" suy động từ toChucId ⇒ to_chuc)
  rewardTitleId   String?
  movementId      String?

  nam             Int
  danhHieu        String?
  capKhen         String?
  soQuyetDinh     String?
  ngayQuyetDinh   DateTime? @db.Date
  coQuanQuyetDinh String?
  thanhTich       String?
  ghiChu          String?

  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nam])
  @@index([toChucId])
  @@map("office_collective_reward_records")
}

enum MucXepLoai {
  HOAN_THANH_XUAT_SAC_NHIEM_VU
  HOAN_THANH_TOT_NHIEM_VU
  HOAN_THANH_NHIEM_VU
  KHONG_HOAN_THANH_NHIEM_VU
}

/// Đánh giá, xếp loại chất lượng hằng năm
model OfficeAnnualEvaluation {
  id              String     @id @default(cuid())
  canBoId         String
  canBo           CanBo      @relation(fields: [canBoId], references: [id], onDelete: Cascade)
  nam             Int
  mucXepLoai      MucXepLoai
  laChienSiThiDua Boolean    @default(false)  // Đạt CSTĐ cơ sở năm này
  soQuyetDinh     String?
  ngayQuyetDinh   DateTime?  @db.Date
  ghiChu          String?

  createdById     String?
  createdBy       User?      @relation("OfficeEvalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([canBoId, nam])
  @@index([nam])
  @@map("office_annual_evaluations")
}

enum HinhThucKyLuat {
  KHIEN_TRACH
  CANH_CAO
  HA_BAC_LUONG
  GIANG_CHUC
  CACH_CHUC
  BUOC_THOI_VIEC
  KHAC
}

/// Kỷ luật & kéo dài thời gian nâng lương (menu 11)
model OfficeDisciplineRecord {
  id                     String        @id @default(cuid())
  canBoId                String
  canBo                  CanBo         @relation(fields: [canBoId], references: [id], onDelete: Cascade)
  hinhThuc               HinhThucKyLuat
  lyDo                   String?
  tuNgay                 DateTime      @db.Date
  denNgay                DateTime?     @db.Date
  soThangKeoDaiNangLuong Int?          // Số tháng kéo dài nâng lương (nếu có)
  soQuyetDinh            String?
  ngayQuyetDinh          DateTime?     @db.Date
  ghiChu                 String?

  createdById            String?
  createdBy              User?         @relation("OfficeDisciplineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([canBoId])
  @@map("office_discipline_records")
}

// ============================================================
//  VĂN PHÒNG SỞ — Quy trình rà soát nâng lương (Commit 4)
//  Sinh danh sách đến hạn → rà soát (đủ/chưa đủ/cần kiểm tra) → trình → duyệt → ban hành.
//  Hệ thống KHÔNG tự quyết định nâng lương; chỉ hỗ trợ quy trình + lưu vết.
// ============================================================

enum TrangThaiRaSoatLuong {
  DU_KIEN      // Dự kiến (mới sinh từ danh sách đến hạn)
  DANG_RA_SOAT // Văn phòng đang rà soát
  CHO_DUYET    // Đã trình, chờ lãnh đạo duyệt
  DA_DUYET     // Lãnh đạo đã duyệt
  DA_BAN_HANH  // Đã ban hành QĐ nâng lương (đã ghi lịch sử lương)
  TU_CHOI      // Không duyệt / dừng
}

enum KetLuanRaSoat {
  DU_DIEU_KIEN      // Đủ điều kiện
  CHUA_DU_DIEU_KIEN // Chưa đủ — cần bổ sung
  CAN_KIEM_TRA      // Cần kiểm tra thêm
}

/// Hồ sơ rà soát nâng lương của 1 cán bộ trong 1 đợt
model OfficeSalaryReviewCase {
  id            String        @id @default(cuid())
  canBoId       String
  canBo         CanBo         @relation(fields: [canBoId], references: [id], onDelete: Cascade)

  loai          LoaiNangLuong @default(THUONG_XUYEN)
  namRaSoat     Int                                    // Năm/đợt rà soát
  dotRaSoat     String?                                // Mô tả đợt (vd "Quý II/2025")
  ngayDenHan    DateTime?     @db.Date                 // Mốc nâng lương kế tiếp tại thời điểm sinh

  heSoHienTai   Float?
  bacHienTai    Int?
  heSoDeXuat    Float?                                 // Hệ số dự kiến sau nâng (Văn phòng đề xuất)
  bacDeXuat     Int?
  ngayHuongMoi  DateTime?     @db.Date                 // Ngày hưởng lương mới (khi ban hành)

  trangThai     TrangThaiRaSoatLuong @default(DU_KIEN)
  ketLuanRaSoat KetLuanRaSoat?
  noiDungRaSoat String?                                // Ghi chú rà soát ngạch/bậc/thời gian giữ bậc/đánh giá/kỷ luật
  canCuPhapLy   String?                                // Số/tên văn bản căn cứ

  nguoiRaSoatId String?
  nguoiRaSoat   User?         @relation("SalaryCaseReviewer", fields: [nguoiRaSoatId], references: [id], onDelete: SetNull)
  ngayRaSoat    DateTime?
  nguoiDuyetId  String?
  nguoiDuyet    User?         @relation("SalaryCaseApprover", fields: [nguoiDuyetId], references: [id], onDelete: SetNull)
  ngayDuyet     DateTime?

  soQuyetDinh   String?                                // Số QĐ nâng lương (khi ban hành)
  ngayQuyetDinh DateTime?     @db.Date
  ghiChu        String?

  createdById   String?
  createdBy     User?         @relation("SalaryCaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  generatedDocuments OfficeGeneratedDocument[]

  @@unique([canBoId, namRaSoat, loai])
  @@index([trangThai])
  @@index([namRaSoat])
  @@index([canBoId])
  @@map("office_salary_review_cases")
}

enum LoaiVanBanVPS {
  QD_NANG_LUONG   // Quyết định nâng bậc lương
  QD_KHEN_THUONG  // Quyết định khen thưởng
  QD_KY_LUAT      // Quyết định kỷ luật
  THONG_BAO       // Thông báo
  TB_NGHI_HUU     // Thông báo nghỉ hưu (trước 6 tháng — NĐ 46/2010)
  QD_NGHI_HUU     // Quyết định nghỉ hưu (trước 3 tháng — NĐ 46/2010)
  KHAC
}

/// Lưu vết văn bản đã sinh (bất biến) — văn bản ban hành lưu nguyên bản .docx
model OfficeGeneratedDocument {
  id           String        @id @default(cuid())
  loaiVanBan   LoaiVanBanVPS @default(QD_NANG_LUONG)

  canBoId      String?
  canBo        CanBo?        @relation(fields: [canBoId], references: [id], onDelete: SetNull)
  reviewCaseId String?
  reviewCase   OfficeSalaryReviewCase? @relation(fields: [reviewCaseId], references: [id], onDelete: SetNull)

  soVanBan     String?
  tieuDe       String
  fileName     String
  noiDung      Bytes                                   // Nội dung .docx (immutable)

  createdById  String?
  createdBy    User?         @relation("OfficeDocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([loaiVanBan])
  @@index([canBoId])
  @@index([createdAt])
  @@map("office_generated_documents")
}

// ─── VĂN PHÒNG SỞ: QUẢN LÝ NGHỈ PHÉP (toàn Sở) ──────────────────────────────

enum LoaiNghiPhep {
  PHEP_NAM      // Nghỉ phép năm
  OM            // Nghỉ ốm
  THAI_SAN      // Nghỉ thai sản
  KHONG_LUONG   // Nghỉ không hưởng lương
  VIEC_RIENG    // Nghỉ việc riêng có hưởng lương (cưới, tang...)
  BU            // Nghỉ bù
  KHAC
}

enum TrangThaiNghiPhep {
  CHO_DUYET        // (legacy) Chờ duyệt
  DA_DUYET         // (legacy) Đã duyệt
  CHO_TRUONG_PHONG // Chờ Trưởng phòng duyệt
  CHO_LANH_DAO_SO  // Chờ Lãnh đạo Sở ký
  CHO_VAN_PHONG    // Chờ Văn phòng Sở xem xét / vào sổ
  CHO_TAI_CHINH    // Chờ Phòng KH-TC cho ứng lương
  HOAN_TAT         // Hoàn tất
  TU_CHOI          // Từ chối
  DA_HUY           // Đã huỷ
}

/// Đơn nghỉ phép — áp dụng cho cán bộ TOÀN SỞ (không chỉ Văn phòng Sở)
model OfficeLeaveRequest {
  id           String            @id @default(cuid())
  canBoId      String
  canBo        CanBo             @relation(fields: [canBoId], references: [id], onDelete: Cascade)

  loaiNghi     LoaiNghiPhep      @default(PHEP_NAM)
  tuNgay       DateTime          @db.Date
  denNgay      DateTime          @db.Date
  soNgay       Float                                   // Số ngày nghỉ (cho phép 0.5)
  lyDo         String?
  trangThai    TrangThaiNghiPhep @default(CHO_TRUONG_PHONG)

  // Mẫu đơn
  nguoiBanGiao    String?                              // Người nhận bàn giao công việc
  noiNghi         String?                              // Nơi nghỉ / địa chỉ liên hệ
  dienThoaiLienHe String?
  deNghiUngLuong  Boolean        @default(false)       // Người làm đơn đề nghị ứng lương
  soTienUng       Float?                               // KH-TC nhập khi cho ứng

  // (legacy) Duyệt 1 bước — giữ để tương thích dữ liệu cũ
  nguoiDuyetId String?                                 // users.id (scalar)
  ngayDuyet    DateTime?
  ghiChuDuyet  String?

  // Cấp 1 — Trưởng phòng
  tpDuyetId    String?
  tpNgay       DateTime?
  tpYKien      String?
  // Cấp 2 — Lãnh đạo Sở ký
  ldsKyId      String?
  ldsNgay      DateTime?
  ldsYKien     String?
  // Cấp 3 — Văn phòng Sở xem xét / vào sổ
  vpsId        String?
  vpsNgay      DateTime?
  vpsYKien     String?
  // Cấp 4 — Phòng KH-TC cho ứng lương
  khtcId       String?
  khtcNgay     DateTime?
  khtcYKien    String?

  // Từ chối
  tuChoiCap    String?                                 // Cấp từ chối: TRUONG_PHONG / LANH_DAO_SO / VAN_PHONG / TAI_CHINH
  ghiChuTuChoi String?

  // Snapshot định mức phép năm lúc tạo (để in đơn & lưu vết)
  dinhMucPhep  Float?
  daNghiTruoc  Float?

  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  signatures   OfficeLeaveSignature[]

  @@index([canBoId])
  @@index([trangThai])
  @@index([tuNgay])
  @@map("office_leave_requests")
}

/// Bản PDF đơn nghỉ phép đã ký số của từng cấp (chữ ký chồng dần qua các cấp).
model OfficeLeaveSignature {
  id             String   @id @default(cuid())
  leaveRequestId String
  leaveRequest   OfficeLeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  capCode        String                 // TRUONG_PHONG / VAN_PHONG / LANH_DAO_SO / TAI_CHINH
  nguoiKyId      String?                // users.id
  fileName       String
  fileData       Bytes                  // PDF đã ký (tích luỹ chữ ký các cấp trước)
  soChuKy        Int      @default(0)   // số chữ ký số phát hiện trong file
  signerCN       String?                // CN người ký cấp này
  signerSerial   String?
  signingTime    DateTime?
  hopLe          Boolean  @default(false)
  ghiChuKiemTra  String?
  createdAt      DateTime @default(now())

  @@index([leaveRequestId])
  @@map("office_leave_signatures")
}

// ─── MODULE 9: CẤP PHÉP, CHẤP THUẬN KẾT CẤU HẠ TẦNG ĐƯỜNG BỘ ─────────────────
// Tham chiếu tổ chức/cán bộ/phường-xã bằng cột id thuần (scalar) + tên rút gọn
// để cô lập migration trong phạm vi các bảng mới, không sửa các model dùng chung.

/// Đối tượng đề nghị: tổ chức hoặc cá nhân
enum ApplicantType {
  TO_CHUC   // Tổ chức / doanh nghiệp / chủ đầu tư
  CA_NHAN   // Cá nhân
}

/// Trạng thái xử lý dùng chung cho hồ sơ cấp phép đường bộ (Workflow 9.3)
enum RoadPermitStatus {
  TAO_MOI            // Tạo mới (nháp)
  DA_TIEP_NHAN       // Đã tiếp nhận
  CHO_BO_SUNG        // Chờ bổ sung
  KIEM_TRA_HO_SO     // Đang kiểm tra hồ sơ
  KIEM_TRA_GIS       // Đang kiểm tra GIS / hiện trường
  DANG_THAM_DINH     // Đang thẩm định
  DE_NGHI_CAP        // Đề nghị chấp thuận / cấp phép
  DA_CAP_PHEP        // Đã chấp thuận / đã cấp phép
  TU_CHOI            // Không chấp thuận / từ chối
  DANG_THI_CONG      // Đang thi công
  HOAN_THANH         // Hoàn thành / đã nghiệm thu
  HET_HAN            // Hết hạn
  THU_HOI            // Thu hồi / huỷ
}

/// Loại giấy phép xe quá khổ, quá tải
enum OversizedPermitType {
  QUA_KHO       // Quá khổ giới hạn
  QUA_TAI       // Quá tải trọng
  BANH_XICH     // Xe bánh xích
  SIEU_TRUONG   // Hàng siêu trường
  SIEU_TRONG    // Hàng siêu trọng
}

/// Loại đấu nối vào đường bộ
enum ConnectionType {
  CHINH_THUC    // Đấu nối chính thức
  TAM_THOI      // Đấu nối tạm thời
}

/// Giai đoạn xử lý hồ sơ đấu nối
enum ConnectionStage {
  CHAP_THUAN_VI_TRI    // Chấp thuận vị trí đấu nối
  CHAP_THUAN_THIET_KE  // Chấp thuận thiết kế nút giao
  CAP_PHEP_THI_CONG    // Cấp phép thi công
}

/// Cấp quản lý / loại đường
enum RoadClass {
  QUOC_LO       // Quốc lộ
  DUONG_TINH    // Đường tỉnh
  DUONG_HUYEN   // Đường huyện
  DUONG_DO_THI  // Đường đô thị
  DUONG_XA      // Đường xã
  DUONG_CHUYEN_DUNG // Đường chuyên dùng
}

/// Phương tiện trong hồ sơ cấp phép (đăng ký dùng lại nhiều lần)
model PermitVehicle {
  id              String   @id @default(cuid())
  plateNumber     String   @unique                // Biển số
  ownerName       String                          // Chủ xe
  brand           String?                          // Nhãn hiệu
  vehicleType     String?                          // Loại xe
  axleCount       Int?                             // Số trục
  designLoadTon   Float?                           // Tải trọng thiết kế (tấn)
  registeredLoadTon Float?                         // Tải trọng đăng kiểm (tấn)
  lengthM         Float?                           // Dài (m)
  widthM          Float?                           // Rộng (m)
  heightM         Float?                           // Cao (m)
  techSpecs       String?                          // Thông số kỹ thuật khác
  inspectionDocs  String[] @default([])            // Hồ sơ đăng kiểm (đường dẫn)
  images          String[] @default([])            // Ảnh phương tiện
  note            String?

  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permits         OversizedVehiclePermit[]

  @@index([ownerName])
  @@map("permit_vehicles")
}

/// Hồ sơ cấp giấy phép lưu hành xe quá khổ, quá tải (9.1)
model OversizedVehiclePermit {
  id              String              @id @default(cuid())
  fileCode        String              @unique          // Mã hồ sơ
  permitType      OversizedPermitType @default(QUA_TAI)
  status          RoadPermitStatus    @default(TAO_MOI)

  // Đối tượng đề nghị
  applicantType   ApplicantType       @default(TO_CHUC)
  applicantName   String                                // Tên tổ chức/cá nhân
  applicantOrgId  String?                               // to_chuc.id nếu là tổ chức nội bộ
  applicantPhone  String?
  applicantAddress String?

  // Phương tiện
  vehicleId       String?
  vehicle         PermitVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Hàng hoá & tải trọng thực tế khai báo
  cargoType       String?                               // Loại hàng
  totalWeightTon  Float?                                // Tổng trọng lượng xe + hàng (tấn)
  axleLoadTon     Float?                                // Tải trọng trục lớn nhất (tấn)
  overallLengthM  Float?                                // Kích thước bao ngoài - dài
  overallWidthM   Float?
  overallHeightM  Float?

  // Lưu hành
  travelFrom      String?                               // Điểm đầu tuyến lưu hành
  travelTo        String?                               // Điểm cuối
  validFrom       DateTime?                             // Thời gian lưu hành từ
  validTo         DateTime?                             // đến

  // Thẩm định
  needEscort      Boolean             @default(false)   // Cần xe dẫn đường/hộ tống
  appraisalNote   String?                               // Ý kiến thẩm định / xử lý
  supplementNote  String?                               // Yêu cầu bổ sung

  // Giấy phép phát hành
  permitNumber    String?                               // Số giấy phép
  issuedAt        DateTime?                             // Ngày cấp
  permitValidTo   DateTime?                             // Thời hạn
  conditions      String?                               // Điều kiện lưu hành, ATGT
  pdfPath         String?                               // File PDF giấy phép
  qrData          String?                               // Dữ liệu QR

  attachments     String[]            @default([])      // Hồ sơ đính kèm
  wardId          String?                               // Địa bàn (administrative_units.id)
  createdById     String?
  appraisedById   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  routes          PermitRoute[]
  statusLogs      RoadPermitStatusLog[]

  @@index([status])
  @@index([permitType])
  @@index([createdAt])
  @@map("oversized_vehicle_permits")
}

/// Đoạn tuyến lưu hành GIS gắn với 1 hồ sơ xe quá khổ/quá tải (9.1)
model PermitRoute {
  id              String   @id @default(cuid())
  permitId        String
  permit          OversizedVehiclePermit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  sequence        Int      @default(1)               // Thứ tự đoạn
  roadName        String                              // Tên tuyến / đoạn tuyến
  roadClass       RoadClass?
  fromKm          Float?                              // Lý trình đầu (Km)
  toKm            Float?                              // Lý trình cuối (Km)
  geojson         Json?                               // Hình học đoạn tuyến (LineString)

  // Yếu tố hạn chế dọc tuyến
  bridgeTunnelNote String?                            // Cầu/cống/hầm/nút giao
  weakSegmentNote  String?                            // Đường yếu / khu vực hạn chế tải trọng
  turningRadiusM   Float?                             // Bán kính quay đầu
  roadWidthM       Float?                             // Chiều rộng mặt đường
  clearanceHeightM Float?                             // Chiều cao tĩnh không
  warning          String?                            // Cảnh báo tuyến không phù hợp

  createdAt       DateTime @default(now())

  @@index([permitId])
  @@map("permit_routes")
}

/// Hồ sơ đấu nối / nút giao / cấp phép thi công đường bộ (9.2)
model RoadConnectionApplication {
  id              String           @id @default(cuid())
  fileCode        String           @unique
  connectionType  ConnectionType   @default(CHINH_THUC)
  stage           ConnectionStage  @default(CHAP_THUAN_VI_TRI)
  status          RoadPermitStatus @default(TAO_MOI)

  // Đối tượng
  applicantType   ApplicantType    @default(TO_CHUC)
  applicantName   String                              // Tổ chức/cá nhân/chủ đầu tư
  applicantOrgId  String?
  applicantPhone  String?
  projectName     String?                             // Dự án / công trình

  // Vị trí
  roadName        String?                             // Tuyến đường
  roadClass       RoadClass?
  km              Float?                               // Lý trình
  latitude        Float?
  longitude       Float?
  wardId          String?                              // Địa bàn

  purpose         String?                              // Mục đích đấu nối
  designNote      String?                              // Thiết kế
  trafficPlan     String?                              // Phương án tổ chức giao thông
  safetyDocs      String?                              // Hồ sơ ATGT
  restorationNote String?                              // Hoàn trả / bảo vệ hạ tầng

  appraisalNote   String?
  supplementNote  String?

  attachments     String[]         @default([])
  createdById     String?
  appraisedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  locations       RoadConnectionLocation[]
  inspections     RoadConnectionInspection[]
  permits         RoadConnectionPermit[]
  statusLogs      RoadPermitStatusLog[]

  @@index([status])
  @@index([connectionType])
  @@index([stage])
  @@index([createdAt])
  @@map("road_connection_applications")
}

/// Vị trí GIS đấu nối gắn với hồ sơ (9.2)
model RoadConnectionLocation {
  id              String   @id @default(cuid())
  applicationId   String
  application     RoadConnectionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  label           String?                            // Mô tả vị trí / nút giao
  km              Float?                             // Lý trình
  latitude        Float?
  longitude       Float?
  geojson         Json?                              // Hình học (Point/Polygon)

  // Cảnh báo chồng lấn (lưu danh sách mã cảnh báo)
  overlapWarnings String[] @default([])              // hành lang, vỉa hè, lòng đường, thoát nước, cây xanh, chiếu sáng, biển báo, hạ tầng ngầm
  note            String?

  createdAt       DateTime @default(now())

  @@index([applicationId])
  @@map("road_connection_locations")
}

/// Phiếu thẩm định / xử lý hồ sơ đấu nối (9.2)
model RoadConnectionInspection {
  id              String   @id @default(cuid())
  applicationId   String
  application     RoadConnectionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  inspectionType  String                              // tiếp nhận / kiểm tra thành phần / kiểm tra GIS / thẩm định ...
  result          String?                             // Kết quả / ý kiến
  inspectedById   String?
  inspectedAt     DateTime @default(now())
  attachments     String[] @default([])

  @@index([applicationId])
  @@map("road_connection_inspections")
}

/// Văn bản chấp thuận / giấy phép thi công đầu ra của hồ sơ đấu nối (9.2)
model RoadConnectionPermit {
  id              String           @id @default(cuid())
  applicationId   String
  application     RoadConnectionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  stage           ConnectionStage  @default(CHAP_THUAN_VI_TRI)
  permitNumber    String?                             // Số văn bản
  issuedAt        DateTime?
  validTo         DateTime?
  conditions      String?
  pdfPath         String?
  createdAt       DateTime         @default(now())

  @@index([applicationId])
  @@map("road_connection_permits")
}

/// Căn cứ pháp lý cho cấp phép đường bộ (9.3) — kiểm tra hiệu lực
model RoadLegalReference {
  id              String   @id @default(cuid())
  code            String                              // Số hiệu văn bản
  title           String                              // Trích yếu
  documentType    String?                             // Loại văn bản (Luật, NĐ, TT...)
  issuedDate      DateTime?
  effectiveDate   DateTime?
  expiryDate      DateTime?                           // Hết hiệu lực (null = còn hiệu lực)
  isActive        Boolean  @default(true)
  scope           String?                             // Phạm vi áp dụng
  url             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@map("road_legal_references")
}

/// Lưu vết chuyển trạng thái hồ sơ cấp phép đường bộ (dùng chung 2 loại hồ sơ)
model RoadPermitStatusLog {
  id              String   @id @default(cuid())
  fromStatus      RoadPermitStatus?
  toStatus        RoadPermitStatus
  note            String?
  changedById     String?
  changedAt       DateTime @default(now())

  oversizedPermitId String?
  oversizedPermit   OversizedVehiclePermit? @relation(fields: [oversizedPermitId], references: [id], onDelete: Cascade)
  connectionApplicationId String?
  connectionApplication   RoadConnectionApplication? @relation(fields: [connectionApplicationId], references: [id], onDelete: Cascade)

  @@index([oversizedPermitId])
  @@index([connectionApplicationId])
  @@map("road_permit_status_logs")
}

// ─── CHẤM CÔNG LÀM THÊM GIỜ (theo phòng ban / tháng) ────────────────────────
// Tham chiếu tổ chức/cán bộ bằng id thuần (scalar) để cô lập migration, không
// sửa các model dùng chung (ToChuc/CanBo). Nhập TỔNG giờ/người theo 4 loại:
// ngày thường, thứ Bảy, Chủ nhật, làm đêm. Trần 200 giờ/người/năm (BLLĐ 2019 Đ.107).

/// Bảng chấm công làm thêm giờ của 1 phòng trong 1 tháng.
model OvertimeTimesheet {
  id              String   @id @default(cuid())
  toChucId        String                          // Phòng/đơn vị (to_chuc.id)
  tenPhong        String                          // Snapshot tên phòng (in văn bản)
  thang           Int                             // 1..12
  nam             Int
  tuNgay          DateTime  @db.Date              // Thời gian làm thêm: từ ngày
  denNgay         DateTime  @db.Date              // đến ngày
  ngayKy          DateTime? @db.Date              // Ngày ký (tự né Thứ Bảy/Chủ nhật)
  diaDiem         String?                         // Địa điểm làm thêm
  lyDo            String?                         // Lý do làm thêm (nhiều dòng "+")
  nguoiChamCong   String?                         // Họ tên người chấm công
  truongPhong     String?                         // Họ tên Trưởng phòng ký
  lanhDaoSo       String?                         // Họ tên Lãnh đạo Sở phê duyệt
  chucDanhLanhDao String?                         // VD: Phó Giám đốc
  ghiChu          String?

  // Quy trình ký số: NHAP → CHO_TP → CHO_LD → CHO_VT → CHO_KHTC → HOAN_TAT (hoặc TU_CHOI)
  trangThai         String  @default("NHAP")
  chuKyChamCong     Bytes?                         // Ảnh chữ ký người chấm công (không ký số)
  chuKyChamCongMime String?
  tuChoiCap         String?
  ghiChuTuChoi      String?

  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries         OvertimeEntry[]
  signatures      OvertimeSignature[]

  @@unique([toChucId, thang, nam])
  @@index([nam])
  @@index([toChucId])
  @@map("overtime_timesheets")
}

/// Bản PDF đã ký số của từng cấp (chữ ký chồng dần qua các cấp) — bảng chấm công làm thêm.
model OvertimeSignature {
  id            String   @id @default(cuid())
  timesheetId   String
  timesheet     OvertimeTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  capCode       String                 // TRUONG_PHONG / LANH_DAO_SO / VAN_THU / TAI_CHINH
  nguoiKyId     String?
  fileName      String
  fileData      Bytes                  // PDF đã ký (tích luỹ chữ ký các cấp trước)
  soChuKy       Int      @default(0)
  signerCN      String?
  signerSerial  String?
  signingTime   DateTime?
  hopLe         Boolean  @default(false)
  ghiChuKiemTra String?
  ghiChu        String?
  createdAt     DateTime @default(now())

  @@index([timesheetId])
  @@map("overtime_signatures")
}

/// 1 dòng = 1 người trong bảng chấm công (tổng giờ theo 4 loại).
model OvertimeEntry {
  id          String   @id @default(cuid())
  timesheetId String
  timesheet   OvertimeTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  canBoId     String?                             // can_bo.id (scalar, có thể null nếu nhập tay)
  hoTen       String
  chucVu      String?
  thuTu       Int      @default(0)

  // Giờ làm thêm CHI TIẾT theo từng ngày: { "1": 4, "2": 0, ... } (key = ngày trong tháng)
  gioNgay     Json     @default("{}")
  // (Cũ — không dùng nữa, giữ để tương thích dữ liệu) gộp theo loại
  gioThuong   Float    @default(0)                // Giờ làm thêm ngày thường (150%)
  gioT7       Float    @default(0)                // Giờ thứ Bảy (200%)
  gioCN       Float    @default(0)                // Giờ Chủ nhật / lễ (200–300%)
  gioDem      Float    @default(0)                // Giờ làm đêm (phụ trội 30%)
  ghiChu      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([timesheetId])
  @@index([canBoId])
  @@map("overtime_entries")
}

// ─── MODULE BIM/AIM (migration 023) ─────────────────────────────────────────
// Căn cứ: QĐ 258/QĐ-TTg, NĐ 175/2024/NĐ-CP, QĐ 348 & 347/QĐ-BXD, ISO 19650.
// Thiết kế: C:\Troly\HTKT\Thiet_Ke_Module_BIM_AIM_Theo_Phap_Ly_VN.md

/// Mô hình BIM — 1 công trình có thể nhiều mô hình theo bộ môn (discipline).
model BimModel {
  id                  String    @id @default(cuid())
  maMoHinh            String    @unique              // BIM-2026-0001
  ten                 String
  moTa                String?
  discipline          String    @default("TONG_HOP") // KIEN_TRUC/KET_CAU/CO_DIEN/HA_TANG_GIAO_THONG/CAP_THOAT_NUOC/CHIEU_SANG/TONG_HOP
  projectId           String?                        // FK mềm → projects
  assetId             String?                        // FK mềm → assets
  soGiayPhep          String?
  soQuyetDinhThamDinh String?
  capCongTrinh        String?                        // CAP_DAC_BIET/CAP_I/CAP_II/CAP_III/CAP_IV
  nguonVon            String?                        // DAU_TU_CONG/VON_NN/PPP/VON_KHAC
  batBuocBim          Boolean   @default(false)      // thuộc diện QĐ 258/QĐ-TTg
  wardId              String?
  diaChi              String?
  latitude            Float?
  longitude           Float?
  dataStatus          String    @default("verified")
  sourceSystem        String    @default("QLHTKT")
  metadata            Json?
  createdById         String?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  versions    BimModelVersion[]
  viewPerms   BimViewPermission[]

  @@index([projectId])
  @@index([wardId])
  @@index([capCongTrinh])
  @@map("bim_models")
}

/// Phiên bản mô hình — vòng đời CDE theo ISO 19650: SHARED → PUBLISHED → ARCHIVED.
model BimModelVersion {
  id            String    @id @default(cuid())
  modelId       String
  model         BimModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  versionNo     Int
  maContainer   String                              // QT-SXD-BIM-2026-0001-V03
  stage         String                              // NCTKT/NCKT_TKCS/TK_KY_THUAT/TK_BAN_VE_THI_CONG/HOAN_CONG
  lodChinh      String                              // LOD_100..LOD_500
  cdeStatus     String    @default("SHARED")        // SHARED/PUBLISHED/ARCHIVED
  ghiChuNop     String?
  nguoiNopTen   String?
  nguoiNopDonVi String?                             // đơn vị tư vấn lập mô hình
  ngayTiepNhan  DateTime  @default(now())
  publishedById String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  archiveReason String?
  metadata      Json?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  files              BimFile[]
  consistencyReviews BimConsistencyReview[]

  @@unique([modelId, versionNo])
  @@index([cdeStatus])
  @@map("bim_model_versions")
}

/// Tệp BIM — định dạng gốc + IFC 4.0 song song, ≤500MB/file (NĐ 175/2024).
model BimFile {
  id            String    @id @default(cuid())
  versionId     String
  version       BimModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind          String                              // GOC/IFC/PHU_TRO
  tenFile       String
  dinhDang      String                              // ifc/rvt/dgn/pln/bcf/pdf...
  schemaVersion String?                             // IFC4/IFC4X3/IFC2X3
  dungLuongByte BigInt
  sha256        String                              // toàn vẹn pháp lý — file là căn cứ thẩm định
  storagePath   String                              // private, stream qua API có kiểm quyền
  uploadedById  String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  validationChecks BimValidationCheck[]

  @@index([versionId])
  @@map("bim_files")
}

/// Kết quả kiểm tra hợp lệ tự động khi tiếp nhận tệp (NĐ 175/2024).
model BimValidationCheck {
  id        String   @id @default(cuid())
  fileId    String
  file      BimFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  checkCode String                                  // FILE_SIZE_500MB/IFC_SCHEMA_VALID/HAS_GEOLOCATION/HAS_GEOMETRY_3D/HAS_MAIN_DIMENSIONS/HAS_PROJECT_INFO
  ketQua    String                                  // PASS/FAIL/WARNING
  chiTiet   Json?
  checkedAt DateTime @default(now())

  @@index([fileId])
  @@map("bim_validation_checks")
}

/// Đánh giá tính nhất quán mô hình ↔ tính toán/thiết kế — bắt buộc cấp I/đặc biệt.
model BimConsistencyReview {
  id             String   @id @default(cuid())
  versionId      String
  version        BimModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  nguoiDanhGiaId String
  noiDung        String
  ketLuan        String                             // NHAT_QUAN/KHONG_NHAT_QUAN/NHAT_QUAN_CO_DIEU_KIEN
  yeuCauBoSung   String?
  vanBanSo       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([versionId])
  @@map("bim_consistency_reviews")
}

/// Phân quyền xem/tải mô hình — theo role, phòng (to_chuc) hoặc cá nhân.
model BimViewPermission {
  id          String   @id @default(cuid())
  modelId     String
  model       BimModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  roleId      String?
  toChucId    String?
  userId      String?
  quyen       String   @default("VIEW")             // VIEW/DOWNLOAD/MANAGE
  grantedById String?
  createdAt   DateTime @default(now())

  @@index([modelId])
  @@map("bim_view_permissions")
}

// ─── TRA CỨU TÀI LIỆU (RAG) ──────────────────────────────────────────────────

/// Tài liệu nạp vào kho tra cứu (PDF/Word/dán text). DDL: 024_rag_tai_lieu.sql.
model TaiLieu {
  id          String         @id @default(cuid())
  tieuDe      String
  loai        String         @default("KHAC") // VB_PHAP_LUAT/QUY_TRINH/HUONG_DAN/BAO_CAO/BIEU_MAU/KHAC
  nguon       String? // tên file gốc hoặc URL
  moTa        String?
  phamVi      String         @default("NOI_BO_SO") // CONG_KHAI/NOI_BO_SO
  soChunk     Int            @default(0)
  soKyTu      Int            @default(0)
  trangThai   String         @default("dang_xu_ly") // dang_xu_ly/san_sang/loi
  ghiChuLoi   String?

  // ── Tình trạng hiệu lực pháp lý (mig 043) ──────────────────────────────────
  // Đồng bộ từ prisma/hieu-luc-vbpl.json bằng scripts/sync-hieu-luc-tai-lieu.mjs.
  // RAG dùng để CẢNH BÁO khi đoạn trích đến từ văn bản đã hết hiệu lực, tránh
  // chatbot viện dẫn văn bản cũ làm căn cứ hiện hành.
  tinhTrangHieuLuc String      @default("can_kiem_chung") // con_hieu_luc/het_hieu_luc/du_thao/can_kiem_chung
  thayTheBoi       String?                                // số hiệu văn bản thay thế
  ghiChuHieuLuc    String?

  metadata    Json?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  chunks      TaiLieuChunk[]

  @@index([phamVi])
  @@index([loai])
  @@index([tinhTrangHieuLuc])
  @@map("tai_lieu")
}

/// Đoạn văn bản + vector nhúng. Cột embedding kiểu vector(1536) (pgvector) —
/// Prisma không hiểu kiểu vector nên dùng Unsupported; thao tác vector qua $queryRaw.
model TaiLieuChunk {
  id         String                       @id @default(cuid())
  taiLieuId  String
  taiLieu    TaiLieu                      @relation(fields: [taiLieuId], references: [id], onDelete: Cascade)
  chunkIndex Int
  noiDung    String
  embedding  Unsupported("vector(1536)")?
  soToken    Int?
  viTri      String?
  createdAt  DateTime                     @default(now())

  @@index([taiLieuId])
  @@map("tai_lieu_chunk")
}

// ─── QUẢN LÝ CÔNG VIỆC PHÒNG/BAN (dùng chung 11 phòng theo QĐ 331) ───────────
// Lõi 1 bảng cho mọi phòng (toChucId), + loại việc cấu hình theo phòng kèm
// trường động (fieldSchema/customFields JSONB) → mỗi phòng tự mở rộng KHÔNG
// cần migration. Liên thông mềm với Project/WorkOrder/Incident đã có.

enum CongViecTrangThai {
  MOI            // Mới / chưa bắt đầu
  DANG_LAM       // Đang thực hiện
  TAM_DUNG       // Tạm dừng
  CHO_DUYET      // Chờ duyệt / nghiệm thu
  HOAN_THANH     // Hoàn thành
  HUY            // Huỷ
}

enum CongViecUuTien {
  THAP
  TRUNG_BINH
  CAO
  KHAN_CAP
}

enum CongViecVaiTro {
  CHU_TRI        // Chủ trì
  PHOI_HOP       // Phối hợp
  THEO_DOI       // Theo dõi / giám sát
}

enum CongViecNhatKyLoai {
  TAO
  DOI_TRANG_THAI
  CAP_NHAT_TIEN_DO
  BINH_LUAN
  GIAO_VIEC
  DINH_KEM
  KHAC
}

// Loại công việc — cấu hình theo từng phòng (toChucId NULL = dùng chung).
// fieldSchema: mảng định nghĩa trường động [{name,label,type,required,options}].
model CongViecLoai {
  id          String     @id @default(cuid())
  toChucId    String?
  toChuc      ToChuc?    @relation(fields: [toChucId], references: [id])
  ten         String
  moTa        String?
  mauSac      String?
  fieldSchema Json?
  thuTu       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  congViecs   CongViec[]

  @@index([toChucId])
  @@map("cong_viec_loai")
}

model CongViec {
  id              String            @id @default(cuid())
  maCongViec      String            @unique          // CV-2026-000001
  tieuDe          String
  moTa            String?
  // Phòng sở hữu việc — scope "việc của phòng mình"
  toChucId        String
  toChuc          ToChuc            @relation(fields: [toChucId], references: [id])
  loaiId          String?
  loai            CongViecLoai?     @relation(fields: [loaiId], references: [id])
  trangThai       CongViecTrangThai @default(MOI)
  uuTien          CongViecUuTien    @default(TRUNG_BINH)
  tienDo          Int               @default(0)      // 0..100 (%)
  // Người liên quan (tài khoản đăng nhập)
  nguoiGiaoId     String?
  nguoiGiao       User?             @relation("CongViecNguoiGiao", fields: [nguoiGiaoId], references: [id])
  nguoiPhuTrachId String?
  nguoiPhuTrach   User?             @relation("CongViecNguoiPhuTrach", fields: [nguoiPhuTrachId], references: [id])
  // Thời gian
  ngayBatDau      DateTime?         @db.Date
  ngayHetHan      DateTime?         @db.Date
  ngayHoanThanh   DateTime?
  // Phân cấp việc cha → việc con
  congViecChaId   String?
  congViecCha     CongViec?         @relation("CongViecCon", fields: [congViecChaId], references: [id])
  congViecCons    CongViec[]        @relation("CongViecCon")
  // Liên thông module hiện trường (FK mềm, không ràng buộc cứng)
  duAnId          String?
  workOrderId     String?
  incidentId      String?
  // Dữ liệu động + đính kèm
