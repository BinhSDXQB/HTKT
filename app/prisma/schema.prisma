  approvalDecisionNo String?           // Số QĐ phê duyệt dự án đầu tư
  approvalAuthority  String?           // Cơ quan phê duyệt
  constructionPermitNo String?         // Số giấy phép xây dựng
  // Quy mô (đặc thù khu đô thị / TĐC)
  landArea        Float?               // Diện tích đất tổng thể (ha)
  residentialLotArea Float?            // Diện tích đất ở (ha)
  plotCount       Int?                 // Số lô đất
  householdCount  Int?                 // Số hộ dân (TĐC)
  // Nội dung
