# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# bản build bị quay lui khi triển khai lỗi (scripts/deploy/vps-auto-deploy.ps1), chỉ để chẩn đoán
/.next-failed/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# log đã xoay vòng (prisma/xoay-vong-log.mjs: sync-vbpl.log.1, .2)
*.log.[0-9]*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# máy chủ dev thử của module Nội dung AI (scripts/ai-content/dev-thu.mjs)
/.next-ai-dev/
