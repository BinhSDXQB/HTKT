# Build zero-downtime cho QLHTKT
# Build vao .next-staging (PM2 van serve .next cu), xong swap + reload
# Giam PM2 xuong 1 instance trong luc build de tiet kiem RAM (may 6GB)

$ErrorActionPreference = "Stop"
$appDir = "c:\Troly\HTKT\app"
$staging = "$appDir\.next-staging"
$live    = "$appDir\.next"
$backup  = "$appDir\.next-old"

Set-Location $appDir

Write-Host "`n====== BUILD ZERO-DOWNTIME ======" -ForegroundColor Cyan

# 1. Xoa staging cu
if (Test-Path $staging) {
    Write-Host "[1/6] Xoa .next-staging cu..." -ForegroundColor Yellow
    Remove-Item $staging -Recurse -Force -Confirm:$false
}

# 2. Giam PM2 xuong 1 instance de free RAM cho build
Write-Host "[2/6] Giam PM2 xuong 1 instance..." -ForegroundColor Yellow
pm2 scale ql-htkt 1 2>$null

# 3. Build vao staging — khong pipe qua PS de tranh OOM
Write-Host "[3/6] Building... (co the mat 2-5 phut)" -ForegroundColor Green
$env:NEXT_DIST_DIR = ".next-staging"
$env:NODE_OPTIONS = "--max-old-space-size=1024"
$buildResult = Start-Process -FilePath "node.exe" `
    -ArgumentList "node_modules/next/dist/bin/next", "build", "--webpack" `
    -WorkingDirectory $appDir `
    -NoNewWindow -Wait -PassThru
Remove-Item Env:\NEXT_DIST_DIR -ErrorAction SilentlyContinue
Remove-Item Env:\NODE_OPTIONS -ErrorAction SilentlyContinue

if ($buildResult.ExitCode -ne 0) {
    Write-Host "BUILD THAT BAI! Phuc hoi PM2 2 instance..." -ForegroundColor Red
    pm2 scale ql-htkt 2 2>$null
    exit 1
}

# 4. Swap thu muc (rename rat nhanh ~1 giay)
Write-Host "[4/6] Swap .next-staging -> .next ..." -ForegroundColor Green
if (Test-Path $backup) { Remove-Item $backup -Recurse -Force -Confirm:$false }
if (Test-Path $live)   { Rename-Item $live ".next-old" }
Rename-Item $staging ".next"

# 5. Reload PM2 + scale lai 2 instance
Write-Host "[5/6] Reload PM2 + scale 2 instance..." -ForegroundColor Green
pm2 reload ql-htkt --update-env 2>$null
Start-Sleep -Seconds 3
pm2 scale ql-htkt 2 2>$null

# 6. Don dep
Write-Host "[6/6] Don dep .next-old..." -ForegroundColor Yellow
if (Test-Path $backup) { Remove-Item $backup -Recurse -Force -Confirm:$false }

Write-Host "`n====== HOAN TAT — KHONG GIAN DOAN ======`n" -ForegroundColor Green
